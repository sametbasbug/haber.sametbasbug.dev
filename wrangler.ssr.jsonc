{
  // Equinox Haber — tek Worker.
  //
  // Hem siteyi sunuyor (Astro SSR, içerik D1'den) hem yayın uçlarını
  // (`/api/brief`, `/api/publish`) barındırıyor. Ayrı bir yayın Worker'ı
  // olabilirdi; iki dağıtım, iki config ve görsel yolunun iki kopyası
  // demekti.
  //
  // `worker/wrangler.jsonc` hâlâ duruyor ama YALNIZ yerel geliştirme ve
  // testler için: uçtan uca takım tek başına koşan Worker'a karşı çalışıyor.
  // Canlıya giden yapılandırma budur.
  "name": "haber-site",
  "main": "dist-ssr/server/entry.mjs",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],

  // Canlı alan adı.
  //
  // Custom Domain, DNS kaydını Cloudflare'in kendisi yönetiyor. Geçişten önce
  // kayıt şuydu ve GERİ DÖNÜŞ YOLU budur:
  //     haber  CNAME  sametbasbug.github.io  (Proxied, TTL Auto)
  //
  // Geri almak için: bu blok kaldırılır, `wrangler deploy` çalıştırılır ve
  // panelden yukarıdaki CNAME yeniden eklenir. GitHub Pages dağıtımı
  // (`deploy.yml`) ve statik derleme bozulmadan duruyor, yani hedef hâlâ
  // ayakta.
  "routes": [
    { "pattern": "haber.sametbasbug.dev", "custom_domain": true }
  ],

  // workers.dev adresi açık kalıyor. `routes` eklendiğinde wrangler onu
  // ÖRTÜK OLARAK kapatıyor; bir kez öyle oldu ve custom domain de
  // bağlanamayınca Worker'ın hiç rotası kalmadı. Önizleme adresi geri dönüş
  // doğrulaması için gerekli: canlı alanla ilgili bir şey ters giderse
  // Worker'ın çalıştığını buradan görebilmek gerekiyor.
  "workers_dev": true,

  // Sayfalar Worker'da üretiliyor; buradaki varlıklar SSR'ın istemci
  // dosyaları (CSS, betikler, görseller).
  //
  // Bir dönem burası statik derlemeyi (`dist-serve`) gösteriyordu: ücretsiz
  // planda Worker başına CPU limiti 10 ms ve ana sayfanın render'ı 626 ms
  // sürüyordu, önbellek soğukken her istek 1102 dönüyordu. Sebep planın
  // dar gelmesi değil, sayfanın savurgan olmasıydı — sinyal skorlaması
  // sıralama karşılaştırıcısının içinde çalışıyor ve istek başına yüz
  // binlerce kalıp derliyordu. Düzeltildikten sonra ölçüm: ana sayfa 48 ms,
  // haber sayfası 12 ms, 29 ardışık soğuk istekte tek kesilme yok.
  //
  // Buranın statik derlemeyi göstermesi hâlâ geçerli bir acil fren: tek
  // satır değiştirip deploy etmek siteyi Worker'ı hiç çalıştırmadan ayağa
  // kaldırır, ama anlık yayını kapatır.
  "assets": {
    "binding": "ASSETS",
    "directory": "dist-ssr/client"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "haber",
      "database_id": "e2ebdbbc-9fcc-4f73-b7f2-215b87307bab",
      "migrations_dir": "worker/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "HERO",
      "bucket_name": "haber-gorseller"
    }
  ],

  // Kimliğimiz Orbit'te: `oauth_clients.client_id`. Sır DEĞİL — hangi sitenin
  // token'ı olduğunu söyleyen bir ad. Secret olarak tutulsaydı ne olduğu
  // panele bakmadan görünmezdi; burada duruyor, sürümleniyor, gözle
  // doğrulanabiliyor.
  //
  // İki işi birden yapıyor. `ORBIT_ISSUER` (secret) ile birlikte tanımlıysa
  // /api/publish Orbit ID token'ı kabul eder, ve /api/orbit-eylem Orbit'in
  // ajan eylem belgelerini karşılar. Biri eksikse ikisi de 503 verir —
  // yarım yapılandırılmış bir kapı, kapalı bir kapıdan kötüdür.
  "vars": {
    "ORBIT_AUDIENCE": "orbit-haber"
  },

  "observability": { "enabled": true }
}
