{
  // Equinox Haber — tek Worker.
  //
  // Hem siteyi sunuyor (Astro SSR, içerik D1'den) hem yayın uçlarını
  // (`/api/brief`, `/api/publish`) barındırıyor. Ayrı bir yayın Worker'ı
  // olabilirdi; iki dağıtım, iki config ve görsel yolunun iki kopyası
  // demekti.
  //
  // `worker/wrangler.jsonc` hâlâ duruyor ama YALNIZ yerel geliştirme ve
  // testler için: uçtan uca takım tek başına koşan Worker'a karşı çalışıyor.
  // Canlıya giden yapılandırma budur.
  "name": "haber-site",
  "main": "dist-ssr/server/entry.mjs",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],

  // Canlı alan adı.
  //
  // Custom Domain, DNS kaydını Cloudflare'in kendisi yönetiyor. Geçişten önce
  // kayıt şuydu ve GERİ DÖNÜŞ YOLU budur:
  //     haber  CNAME  sametbasbug.github.io  (Proxied, TTL Auto)
  //
  // Geri almak için: bu blok kaldırılır, `wrangler deploy` çalıştırılır ve
  // panelden yukarıdaki CNAME yeniden eklenir. GitHub Pages dağıtımı
  // (`deploy.yml`) ve statik derleme bozulmadan duruyor, yani hedef hâlâ
  // ayakta.
  "routes": [
    { "pattern": "haber.sametbasbug.dev", "custom_domain": true }
  ],

  // workers.dev adresi açık kalıyor. `routes` eklendiğinde wrangler onu
  // ÖRTÜK OLARAK kapatıyor; bir kez öyle oldu ve custom domain de
  // bağlanamayınca Worker'ın hiç rotası kalmadı. Önizleme adresi geri dönüş
  // doğrulaması için gerekli: canlı alanla ilgili bir şey ters giderse
  // Worker'ın çalıştığını buradan görebilmek gerekiyor.
  "workers_dev": true,

  // ACİL DURUM MODU — 2026-08-21.
  //
  // Ücretsiz planda Worker başına CPU limiti 10 ms. Astro'nun sayfa render'ı
  // bunun çok üstünde: ana sayfa 612 ms, haber sayfası 20 ms, arşiv sayfası
  // 15 ms (canlıda `wrangler tail` ile ölçüldü). Sonuç, önbellek ısınana
  // kadar her isteğin `exceededCpu` ile 1102 dönmesiydi — site fiilen
  // açılmıyordu. Sıcak önbellek bunu benden gizlemişti: ölçümlerimin hepsi
  // önbellekten dönen yanıtlara bakıyordu.
  //
  // Geçici çözüm: sayfalar statik derlemeden sunuluyor. Varlık isteği
  // Worker'ı HİÇ çalıştırmıyor, dolayısıyla CPU tüketimi sıfır. `dist-serve`
  // = statik derleme (`dist`) + SSR'ın istemci varlıkları
  // (`dist-ssr/client`); ikincisi, bir istek yine de SSR'a düşerse stil ve
  // betiklerin kırılmaması için duruyor.
  //
  // `dist-serve`'de karşılığı olmayan yollar (yani `/api/brief`,
  // `/api/publish`) hâlâ Worker'a düşüyor: yayın uçları ve D1 çalışmaya
  // devam ediyor. Kaybedilen tek şey ANLIK YAYIN — yeni haber statik
  // derleme yenilenene kadar sitede görünmüyor.
  //
  // Kalıcı çözüm iki yoldan biri ve karar Samet'te:
  //   (a) Workers Paid ($5/ay) — CPU limiti 30 sn olur, SSR aynen geri döner.
  //   (b) Render'ı Workers dışına taşımak — anlık yayın makineye bağlanır.
  // Geri dönüş: aşağıdaki directory'yi "dist-ssr/client" yapıp deploy etmek.
  "assets": {
    "binding": "ASSETS",
    "directory": "dist-serve"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "haber",
      "database_id": "e2ebdbbc-9fcc-4f73-b7f2-215b87307bab",
      "migrations_dir": "worker/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "HERO",
      "bucket_name": "haber-gorseller"
    }
  ],

  // Yayın uçları için kimlik ayarı BİLEREK yok.
  //
  // `ORBIT_ISSUER`/`ORBIT_AUDIENCE` tanımlanana kadar `authenticate()` hiçbir
  // isteği kabul etmiyor ve /api/publish her çağrıya 401 dönüyor. Okuma yolu
  // etkilenmiyor. Bu, "yayın açık ama kimlik yarım" durumundan iyidir:
  // paylaşılan bir sırla açılan yazma ucu, herkese açık bir adreste kalıcı
  // hale gelmeye çok müsait.
  //
  // Orbit'te istemci kaydı yapıldığında:
  //   npx wrangler secret put ORBIT_ISSUER   --config wrangler.ssr.jsonc
  //   npx wrangler secret put ORBIT_AUDIENCE --config wrangler.ssr.jsonc
  // ve `publishers` tablosuna Selene'nin `sub` değeri eklenir.

  "observability": { "enabled": true }
}
