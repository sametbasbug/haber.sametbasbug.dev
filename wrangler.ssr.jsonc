{
  // Equinox Haber — tek Worker.
  //
  // Hem siteyi sunuyor (Astro SSR, içerik D1'den) hem yayın uçlarını
  // (`/api/brief`, `/api/publish`) barındırıyor. Ayrı bir yayın Worker'ı
  // olabilirdi; iki dağıtım, iki config ve görsel yolunun iki kopyası
  // demekti.
  //
  // `worker/wrangler.jsonc` hâlâ duruyor ama YALNIZ yerel geliştirme ve
  // testler için: uçtan uca takım tek başına koşan Worker'a karşı çalışıyor.
  // Canlıya giden yapılandırma budur.
  "name": "haber-site",
  "main": "dist-ssr/server/entry.mjs",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "binding": "ASSETS",
    "directory": "dist-ssr/client"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "haber",
      "database_id": "e2ebdbbc-9fcc-4f73-b7f2-215b87307bab",
      "migrations_dir": "worker/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "HERO",
      "bucket_name": "haber-gorseller"
    }
  ],

  // Yayın uçları için kimlik ayarı BİLEREK yok.
  //
  // `ORBIT_ISSUER`/`ORBIT_AUDIENCE` tanımlanana kadar `authenticate()` hiçbir
  // isteği kabul etmiyor ve /api/publish her çağrıya 401 dönüyor. Okuma yolu
  // etkilenmiyor. Bu, "yayın açık ama kimlik yarım" durumundan iyidir:
  // paylaşılan bir sırla açılan yazma ucu, herkese açık bir adreste kalıcı
  // hale gelmeye çok müsait.
  //
  // Orbit'te istemci kaydı yapıldığında:
  //   npx wrangler secret put ORBIT_ISSUER   --config wrangler.ssr.jsonc
  //   npx wrangler secret put ORBIT_AUDIENCE --config wrangler.ssr.jsonc
  // ve `publishers` tablosuna Selene'nin `sub` değeri eklenir.

  "observability": { "enabled": true }
}
