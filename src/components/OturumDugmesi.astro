---
/* Orbit oturum düğmesi.
 *
 * Başlıkta iki kez görünüyor (mobil ve masaüstü blokları ayrı), o yüzden
 * bileşen: oturum okuması ve yapılandırma kontrolü tek yerde kalsın.
 *
 * Okuma sırası ucuzdan pahalıya: veritabanı yoksa (statik derleme) hiç
 * sorulmuyor, çerez yoksa D1'e HİÇ gidilmiyor. Giriş yapmamış ziyaretçi —
 * yani ziyaretçilerin çoğu — bu bileşen yüzünden tek satır okumuyor.
 *
 * Giriş yapmış istekler ara katmanda önbelleği zaten atlıyor; o kural
 * olmasaydı burada basılan ad başkasının ekranına önbelleklenebilirdi.
 */
import { getDatabase, getWorkerEnv } from '#runtime-env';
import { oturumCereziVarMi, oturumOku } from '../server/session';

const veritabani = getDatabase();
const okuyucu = veritabani && oturumCereziVarMi(Astro.request)
	? await oturumOku(veritabani, Astro.request, Date.now())
	: null;

/* Düğme yalnız Orbit TAM yapılandırılmışsa çıkıyor: yarım yapılandırmada
 * basana 503 veren bir düğme, hiç düğme olmamasından kötüdür. */
let girisAcik = false;
if (veritabani) {
	try {
		const env = getWorkerEnv();
		girisAcik = Boolean(env.ORBIT_ISSUER && env.ORBIT_CLIENT_ID && env.ORBIT_CLIENT_SECRET);
	} catch {
		girisAcik = false;
	}
}

/* Girişten sonra aynı sayfaya dönülüyor. */
const donus = Astro.url.pathname + Astro.url.search;

/* `data-astro-reload` KALDIRILAMAZ.
 *
 * `BaseLayout` bir `ClientRouter` (Astro view transitions) kuruyor ve o
 * yönlendirici sayfadaki form gönderimlerini kendi `fetch`'ine alıyor.
 * Buradaki iki form da cevabı sayfaya basılacak bir HTML değil, BAŞKA BİR
 * KAYNAĞA giden 303 yönlendirmesi döndürüyor. İstemci yönlendiricisi
 * cross-origin yönlendirmeyi taşıyamıyor ve gönderimi aynı adrese GET
 * olarak düşürüyor; `/giris/orbit` yalnız POST tanıdığı için ziyaretçi
 * 404 görüyor. Sunucu tarafı bu sırada tamamen doğru çalışıyordu — curl
 * ile 303 ölçülüyordu, tarayıcıda 404 çıkıyordu.
 *
 * Bu öznitelik yönlendiriciye "bu gönderime karışma" diyor: tarayıcı kendi
 * navigasyonunu yapıyor, 303 normal şekilde izleniyor. */
---


{okuyucu && (
	<form class="oturum" method="POST" action="/cikis" data-astro-reload>
		{/* Ad artık profile GİDİYOR. Önce düz metindi ve profil sayfası hiçbir
		    yerden bağlanmıyordu — var olan ama kimsenin bulamayacağı bir adres,
		    olmayan adresten farksız. Giriş yapmış kullanıcının adına tıklamak
		    hesap sayfasına gitmenin en beklenen yolu. */}
		<a class="oturum-ad" href="/profil/" title={okuyucu.displayName ?? 'Orbit hesabı'}>
			{okuyucu.displayName ?? 'Hesabım'}
		</a>
		<button type="submit" class="oturum-dugme">Çıkış</button>
	</form>
)}
{!okuyucu && girisAcik && (
	<form class="oturum" method="POST" action="/giris/orbit" data-astro-reload>
		<input type="hidden" name="donus" value={donus} />
		<button type="submit" class="oturum-dugme">Orbit ile giriş</button>
	</form>
)}

<style>
	/* Görünüm `NewsLayout`taki `.news-action-pill` ile aynı ama o sınıf
	 * BURADA KULLANILAMAZ: Astro stilleri bileşene kapsıyor, yani başka bir
	 * bileşende tanımlı sınıf adı buradaki elemana uygulanmıyor. Sınıfı
	 * yazmak yetiyormuş gibi görünüyor — düğme çıkıyor ama tarayıcının
	 * varsayılan beyaz düğmesi olarak. Bir kez öyle yayımladım.
	 *
	 * Değerler `--news-*` değişkenlerinden geliyor, yani tema değişince ikisi
	 * birlikte değişiyor ve kopya bir palet oluşmuyor. */
	.oturum { display: flex; align-items: center; gap: .5rem; margin: 0; flex-shrink: 0; }
	.oturum-ad {
		max-width: 14ch;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.8rem;
		color: var(--news-muted-strong);
		text-decoration: none;
	}

	.oturum-ad:hover,
	.oturum-ad:focus-visible {
		text-decoration: underline;
	}
	.oturum-dugme {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		align-self: center;
		padding: 0.28rem 0.58rem;
		border: 1px solid color-mix(in srgb, var(--news-border) 88%, transparent);
		border-radius: 999px;
		font-family: inherit;
		font-size: 0.8rem;
		font-weight: 700;
		/* "Orbit ile giriş" iki kelime: sarmasına izin verilirse dar başlıkta
		   iki satıra düşüp masthead'i markanın üstüne bindiriyor. */
		white-space: nowrap;
		color: var(--news-muted-strong);
		background: color-mix(in srgb, var(--news-panel) 85%, transparent);
		cursor: pointer;
	}
	.oturum-dugme:hover {
		color: var(--news-text);
		border-color: var(--news-accent);
	}
</style>
