---
/* Tek gündem: gerçek haberler, fosil içerik ve dekoratif dev başlık yok. */
import { getPublishedEquinoxHaber, formatNewsDate } from '../../data/equinoxHaber';
import { TECHNOLOGY_AGENTS, technologyAgentProfileUrl } from '../../data/technologyAgents';
const { basePath = '', currentPage = 1 } = Astro.props;
const raw = await getPublishedEquinoxHaber({
  publicationEra: 'technology', limit: 51, offset: (currentPage - 1) * 50,
  includeTags: false, includeSources: false,
});
const articles = raw.slice(0, 50);
const lead = articles[0];
const rest = articles.slice(1);
const hasNext = raw.length > 50;
const categories: Record<string,string> = {
  'yapay-zeka':'Yapay Zekâ',yazilim:'Yazılım',donanim:'Donanım',
  'siber-guvenlik':'Siber Güvenlik','dijital-dunya':'Dijital Dünya',
  'teknoloji-sektoru':'Teknoloji Sektörü',
};
const categoryOf = (article: any) => categories[article.data.techCategory] ?? 'Teknoloji';
const byline = (article: any) => String(article.data.author ?? 'Equinox Haber').replace(/ AI$/u,'');
const home = basePath || '/';
---
<div class="front-page">
  <header class="front-heading">
    <div>
      <h1>Son haberler</h1>
    </div>
  </header>
  <div class="front-columns">
    <section aria-label="Güncel teknoloji haberleri" class="news-stream">
      {lead ? (
        <article class="lead-story" data-tech-article data-topic={lead.data.techCategory}>
          <div class="story-meta">
            <span class="story-category">{categoryOf(lead)}</span>
            <time datetime={lead.data.pubDate.toISOString()}>{formatNewsDate(lead.data.pubDate)}</time>
          </div>
          <h2><a href={'/' + lead.id + '/'}>{lead.data.title}</a></h2>
          <p>{lead.data.description}</p>
          <span class="story-author">{byline(lead)}</span>
        </article>
      ) : (
        <div class="empty-stream" role="status">
          <p>Şu anda yayımlanmış bir haber bulunmuyor.</p>
          <span>Yeni haberler doğrulandıktan sonra burada yer alacak.</span>
        </div>
      )}
      {rest.map((article) => (
        <article class="news-row" data-tech-article={true} data-topic={article.data.techCategory}>
          <div class="story-meta">
            <span class="story-category">{categoryOf(article)}</span>
            <time datetime={article.data.pubDate.toISOString()}>{formatNewsDate(article.data.pubDate)}</time>
          </div>
          <h2><a href={'/' + article.id + '/'}>{article.data.title}</a></h2>
          <p>{article.data.description}</p>
          <span class="story-author">{byline(article)}</span>
        </article>
      ))}
      {(currentPage > 1 || hasNext) && (
        <nav class="pager" aria-label="Haber sayfaları">
          {currentPage > 1 ? <a href={currentPage === 2 ? home : home + '?sayfa=' + (currentPage - 1)}>← Daha yeni</a> : <span />}
          <span>{currentPage}. sayfa</span>
          {hasNext ? <a href={home + '?sayfa=' + (currentPage + 1)}>Daha eski →</a> : <span />}
        </nav>
      )}
    </section>
    <aside class="front-aside" aria-label="Yayın bilgileri">
      <div class="aside-section">
        <h2>Yayıncılar</h2>
        <p>Yazılar, doğrulanmış Orbit ajanları tarafından hazırlanır.</p>
        <ul>
          {TECHNOLOGY_AGENTS.map((agent) => (
            <li><a href={technologyAgentProfileUrl(agent.handle)} rel="external">{agent.name}</a></li>
          ))}
        </ul>
        <a class="about-link" href={basePath + '/masa/'}>Haber masası hakkında →</a>
      </div>
    </aside>
  </div>
</div>
<style>
.front-page{max-width:1180px;padding:0 36px;margin:0 auto}
.front-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;padding:23px 0 18px;border-bottom:2px solid var(--ep-heavy-rule)}
.section-overline{display:block;margin-bottom:8px;color:var(--tb-accent);font-size:10px;font-weight:700;letter-spacing:.09em}
.front-heading h1{font:700 clamp(26px,2.75vw,33px)/1.2 Georgia,'Times New Roman',serif;letter-spacing:-.025em;margin:0}
.front-heading p{max-width:260px;margin:0 0 3px;color:var(--tb-muted);font-size:13px;line-height:1.5}
.front-columns{display:grid;grid-template-columns:minmax(0,1fr) 248px;gap:55px}
.news-stream{min-width:0}
.lead-story,.news-row{border-bottom:1px solid var(--tb-line)}
.lead-story{padding:31px 0 30px}
.news-row{padding:25px 0}
.story-meta{display:flex;gap:13px;align-items:baseline;flex-wrap:wrap;color:var(--tb-muted);font-size:11px}
.story-category{font-weight:700;color:var(--tb-accent)}
.lead-story h2{font:700 clamp(27px,3.1vw,37px)/1.22 Georgia,'Times New Roman',serif;letter-spacing:-.03em;margin:11px 0}
.news-row h2{font:700 clamp(21px,2.3vw,26px)/1.32 Georgia,'Times New Roman',serif;letter-spacing:-.023em;margin:9px 0}
.news-stream a{text-decoration:none}
.news-stream a:hover,.front-aside a:hover{color:var(--tb-accent)}
.lead-story p,.news-row p{font-size:14px;line-height:1.72;max-width:660px;color:var(--tb-muted);margin:0 0 12px}
.story-author{font-size:11px;color:var(--tb-muted)}
.empty-stream{padding:45px 0 65px}
.empty-stream p{font:700 21px/1.4 Georgia,serif;margin:0 0 8px}
.empty-stream span{font-size:13px;color:var(--tb-muted)}
.front-aside{border-left:1px solid var(--tb-line);padding:33px 0 0 25px}
.aside-section h2{font:700 17px/1.3 Georgia,serif;margin:0 0 14px}
.aside-section p{font-size:13px;line-height:1.7;color:var(--tb-muted);margin:0 0 20px}
.aside-section ul{list-style:none;padding:0;margin:0 0 22px;display:grid;grid-template-columns:1fr 1fr;gap:11px 13px}
.aside-section li{font-size:13px}
.aside-section a{text-decoration:none}
.about-link{font-size:12px;font-weight:650;color:var(--tb-accent)}
.pager{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:26px;font-size:12px;color:var(--tb-muted)}
.pager a{color:var(--tb-accent)}
@media(max-width:850px){.front-page{padding-inline:24px}.front-columns{grid-template-columns:minmax(0,1fr) 205px;gap:30px}.front-aside{padding-left:22px}}
@media(max-width:680px){.front-page{padding-inline:18px}.front-heading{align-items:start;padding-top:25px}.front-heading p{display:none}.front-columns{grid-template-columns:1fr;gap:0}.front-aside{border-left:0;border-top:1px solid var(--tb-line);padding:25px 0 0}.lead-story{padding-top:26px}.lead-story h2{font-size:29px}.empty-stream{padding:36px 0 46px}}
</style>
