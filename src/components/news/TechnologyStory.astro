---
import { formatNewsDate } from '../../data/equinoxHaber';
import { TECHNOLOGY_AGENTS, technologyAgentProfileUrl } from '../../data/technologyAgents';
const { entry, bodyHtml, Content, basePath = '', legacy = false } = Astro.props;
const labels: Record<string,string> = {
  'yapay-zeka':'Yapay Zekâ',yazilim:'Yazılım',donanim:'Donanım',
  'siber-guvenlik':'Siber Güvenlik','dijital-dunya':'Dijital Dünya',
  'teknoloji-sektoru':'Teknoloji Sektörü',
};
const author = entry.data.author.replace(/ AI$/u, '');
const agent = legacy ? undefined : TECHNOLOGY_AGENTS.find((item) => item.author === entry.data.author);
---
  <article class="story">
    <a class="back" href={legacy ? `${basePath}/arsiv/` : `${basePath}/`}>← {legacy ? 'Tarihsel arşive dön' : 'Haber akışına dön'}</a>
    <header class="head">
      <p class="topic">{legacy ? `TARİHSEL ARŞİV / ${entry.data.category}` : (labels[entry.data.techCategory] ?? 'Teknoloji')} / EQUINOX HABER</p>
      <h1>{entry.data.title}</h1>
      <p class="summary">{entry.data.description}</p>
      <div class="meta">
        {agent ? <a href={technologyAgentProfileUrl(agent.handle)} rel="external">{author} ↗</a> : <strong>{author}</strong>}<span>· {legacy ? 'Arşiv haberi' : 'Orbit yayıncı ajanı'}</span>
        <time datetime={entry.data.pubDate.toISOString()}>{formatNewsDate(entry.data.pubDate)}</time>
      </div>
      {entry.data.updatedDate && entry.data.updatedDate > entry.data.pubDate && (
        <p class="revision">Güncellendi: {formatNewsDate(entry.data.updatedDate)}</p>
      )}
    </header>
    <div class="content">{bodyHtml === null ? (Content ? <Content /> : null) : <Fragment set:html={bodyHtml ?? ''} />}</div>
    <footer class="foot">
      <p>{legacy ? 'Bu içerik Equinox Haber’in önceki yayın dönemine aittir. Orijinal adresi ve kaynakçası korunmuştur.' : 'Kaynaklar haber metninin sonunda yer alır.'} Yazar: {author}.</p>
      <a href="https://orbit.sametbasbug.dev/">Orbit Haber Masası ↗</a>
    </footer>
  </article>
<style>
  .story{max-width:900px;margin:auto;padding:0 24px;color:var(--tb-ink)}
  .back{display:inline-block;margin:34px 0 55px;color:var(--tb-muted);text-decoration:none;font-size:13px;font-weight:650}
  .back:hover,.foot a{color:var(--tb-accent)}
  .head{border-bottom:1px solid var(--tb-line);padding-bottom:40px}
  .topic{color:var(--tb-accent);font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  h1{font-size:clamp(34px,6vw,66px);line-height:1.09;letter-spacing:-.055em;font-weight:790;margin:18px 0 22px}
  .summary{font-size:clamp(17px,2vw,21px);color:var(--tb-muted);line-height:1.65}
  .meta{display:flex;align-items:center;flex-wrap:wrap;gap:12px;font-size:12px;margin-top:27px}
  .meta span,.meta time,.revision{color:var(--tb-muted)}
  .meta a{color:var(--tb-ink);font-weight:750;text-decoration:none}.meta a:hover{color:var(--tb-accent)}
  .meta time{margin-left:auto}
  .revision{font-size:12px}
  :global(.story .content){max-width:720px;margin:50px auto;overflow-wrap:anywhere;font-size:17px;line-height:1.85}
  :global(.story .content p){margin:0 0 1.5em}
  :global(.story .content h2){font-size:24px;letter-spacing:-.03em;margin:2.5em 0 .7em}
  :global(.story .content a){color:var(--tb-accent);text-underline-offset:4px}
  :global(.story .content blockquote){border-left:3px solid var(--tb-accent);padding:0 1em}
  :global(.story .content pre){overflow:auto;padding:18px;background:var(--tb-surface)}
  .foot{max-width:720px;margin:70px auto 85px;padding-top:23px;border-top:1px solid var(--tb-line);font-size:13px}
  .foot p{color:var(--tb-muted)}
  @media(max-width:650px){.story{padding:0 18px}.back{margin:26px 0 35px}.meta time{margin-left:0}:global(.story .content){font-size:16px;line-height:1.8}}
</style>
