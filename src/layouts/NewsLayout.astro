---
import BaseLayout from './BaseLayout.astro';
import OturumDugmesi from '../components/OturumDugmesi.astro';
import { getNewsCategoryHref } from '../data/equinoxHaber';
import { getEquinoxHubUrl, getMainSiteUrl, getNewsArchiveHref, getNewsHomePath, getNewsHomeHref, getSourceCodeHref, isNewsSubdomainEnabled } from '../data/newsSite';

interface Props {
	title: string;
	description: string;
	pageTitle: string;
	pageDescription?: string;
	categories?: string[];
	activeCategory?: string;
	hidePageHero?: boolean;
	categoryNavForceReload?: boolean;
	showCategoryNav?: boolean;
	showFooter?: boolean;
	noindex?: boolean;
	canonicalPath?: string;
	/** Başlığın üstündeki küçük etiket. Boş verilirse hiç basılmaz — arşivde
	 * başlığın kendisi zaten "Arşiv" diyor, ikisi birden tekrar olurdu. Yanıp
	 * sönen nokta yalnız varsayılan "Canlı akış" değerinde gösterilir. */
	kicker?: string;
	ogImage?: string;
	ogImageAlt?: string;
}

const {
	title,
	description,
	pageTitle,
	pageDescription = '',
	categories = [],
	activeCategory = 'Tümü',
	hidePageHero = false,
	categoryNavForceReload = false,
	showCategoryNav = true,
	showFooter = true,
	noindex = false,
	canonicalPath,
	kicker = 'Canlı akış',
	ogImage,
	ogImageAlt,
} = Astro.props;

const navCategories = showCategoryNav ? ['Tümü', ...categories.filter(Boolean)] : [];
const newsHomeHref = getNewsHomeHref();
const newsArchiveHref = getNewsArchiveHref();
const isLiveSurface = kicker === 'Canlı akış';
const sourceCodeHref = getSourceCodeHref();
const newsHomePath = getNewsHomePath();
const blogHomeHref = isNewsSubdomainEnabled() ? getMainSiteUrl() : '/';
/* Başlıktaki çıkış düğmesi Equinox Hub'a gidiyor, ana bloga değil: haber
   sitesi Equinox'un bir parçası. Alt bilgideki "Ana blog" bloga gitmeye
   devam ediyor, yani iki adres de erişilebilir. */
const equinoxHubHref = getEquinoxHubUrl();
---

<BaseLayout title={title} description={description} noindex={noindex} canonicalPath={canonicalPath} ogImage={ogImage} ogImageAlt={ogImageAlt}>
	<section class="news-app-shell" data-news-home-path={newsHomePath}>
		<header class="news-masthead">
			<div class="news-masthead-wrap">
				<div class="news-masthead-inner">
					<div class="news-top-row">
						<a href={newsHomeHref} class="news-brand">
							<span class="news-brand-mark"></span>
							<div class="news-brand-copy">
								<strong>Equinox Haber</strong>
							</div>
						</a>

						<div class="news-actions mobile-only">
							<button class="news-theme-pill" type="button" aria-label="Temayı Değiştir" data-news-theme-toggle>
								<span data-news-theme-icon>🌙</span>
							</button>
							<OturumDugmesi />
							<a href={equinoxHubHref} class="news-action-pill">Equinox</a>
						</div>
					</div>

					{showCategoryNav && (
						<div class="news-nav-row" data-news-nav-row>
							<button class="news-nav-edge news-nav-edge-left" type="button" aria-label="Kategorilerin başına git" data-news-nav-jump="start">‹</button>
							<nav class="news-nav" aria-label="Equinox Haber kategorileri" data-news-nav>
								{navCategories.map((category) => (
									<a
										href={getNewsCategoryHref(category)}
										aria-current={activeCategory === category ? 'page' : undefined}
										data-astro-reload={categoryNavForceReload ? true : undefined}
									>
										{category}
									</a>
								))}
							</nav>
							<button class="news-nav-edge news-nav-edge-right" type="button" aria-label="Kategorilerin sonuna git" data-news-nav-jump="end">›</button>
						</div>
					)}
				</div>

				<div class="news-actions outside desktop-only">
					<button class="news-theme-pill" type="button" aria-label="Temayı Değiştir" data-news-theme-toggle>
						<span data-news-theme-icon>🌙</span>
					</button>
					<OturumDugmesi />
					<a href={equinoxHubHref} class="news-action-pill">Equinox</a>
				</div>
			</div>
		</header>

		{!hidePageHero && (
			<section class="news-hero">
				<div class="news-hero-copy">
					{kicker && (
						<p class="news-kicker">
							{isLiveSurface && <span class="news-live-dot" aria-hidden="true"></span>}
							{kicker}
						</p>
					)}
					{pageTitle && <h1>{pageTitle}</h1>}
					{pageDescription && <p class="news-summary">{pageDescription}</p>}
				</div>
			</section>
		)}

		<div class="news-body">
			<slot />
		</div>

		{showFooter && (
			<footer class="news-footer" aria-label="Equinox Haber alt bağlantıları">
				<div class="news-footer-inner">
					<div class="news-footer-brand">
						<span class="news-footer-kicker">Equinox Haber</span>
						<p>Kaynaklı, kısa ve okunaklı Türkçe haber akışı. Asteria AI ve Selene AI tarafından desteklenir, Samet Başbuğ tarafından yönetilir.</p>
					</div>
					<div class="news-footer-grid">
						<nav class="news-footer-group" aria-label="Yayın bilgileri">
							<h2>Yayın</h2>
							<a href="/hakkimizda/">Hakkımızda</a>
							<a href="/yazarlar/">Yazarlar</a>
							<a href="/iletisim/">İletişim</a>
						</nav>
						<nav class="news-footer-group" aria-label="Yayın ilkeleri">
							<h2>İlkeler</h2>
							<a href="/editorial-ilkeler/">Editoryal ilkeler</a>
							<a href="/duzeltme-politikasi/">Düzeltme politikası</a>
							<a href="/yapay-zeka-ve-yayin-sureci/">AI ve yayın süreci</a>
							<a href="/gizlilik-politikasi/">Gizlilik politikası</a>
						</nav>
						<nav class="news-footer-group" aria-label="Akış ve ekosistem bağlantıları">
							<h2>Akış</h2>
							<a href={newsArchiveHref}>Arşiv</a>
							<a href="/rss.xml">RSS</a>
							<a href="/news-sitemap.xml">News sitemap</a>
							<a href={sourceCodeHref} rel="noopener">Kaynak kodu</a>
							<a href={blogHomeHref}>Ana blog</a>
						</nav>
					</div>
				</div>
			</footer>
		)}
	</section>
</BaseLayout>

<script>
	function initNewsThemeToggle() {
		const buttons = Array.from(document.querySelectorAll('[data-news-theme-toggle]'));
		if (buttons.length === 0) return;

		const sync = () => {
			const theme = document.documentElement.getAttribute('data-theme') || 'dark';
			buttons.forEach((button) => {
				const icon = button.querySelector('[data-news-theme-icon]');
				if (icon) icon.textContent = theme === 'dark' ? '🌙' : '☀️';
			});
		};

		buttons.forEach((button) => {
			if (!(button instanceof HTMLButtonElement) || button.dataset.bound === '1') return;
			button.dataset.bound = '1';
			button.addEventListener('click', () => {
				const current = document.documentElement.getAttribute('data-theme') || 'dark';
				const next = current === 'dark' ? 'light' : 'dark';
				document.documentElement.setAttribute('data-theme', next);
				try { localStorage.setItem('theme', next); } catch {}
				sync();
			});
		});

		sync();
	}

	function initNewsNavJumpButtons() {
		document.querySelectorAll('[data-news-nav-row]').forEach((row) => {
			if (!(row instanceof HTMLElement) || row.dataset.bound === '1') return;
			row.dataset.bound = '1';
			const nav = row.querySelector('[data-news-nav]');
			if (!(nav instanceof HTMLElement)) return;

			row.querySelectorAll('[data-news-nav-jump]').forEach((button) => {
				if (!(button instanceof HTMLButtonElement)) return;
				button.addEventListener('click', () => {
					const direction = button.dataset.newsNavJump;
					nav.scrollTo({
						left: direction === 'end' ? nav.scrollWidth : 0,
						behavior: 'smooth',
					});
				});
			});
		});
	}

	initNewsThemeToggle();
	initNewsNavJumpButtons();
	document.addEventListener('astro:page-load', () => {
		initNewsThemeToggle();
		initNewsNavJumpButtons();
	});
</script>

<style>
	/* Bu blokta bir dönem `body`, `main` ve `html` için `!important` taşıyan
	   geçersiz kılmalar ve `--news-*` token'larının İKİNCİ bir kopyası vardı.
	   Hepsi `BaseLayout`taki blog dönemi paletini bastırmak içindi. O palet
	   silindi; token'ların tek tanımı artık `BaseLayout`ta. Burada kalan
	   şey yalnız bu kabuğun kendi bileşenleri.

	   `body.app-shell-layout` seçicisi de gitti: o sınıf hiçbir yerde
	   `body`ye eklenmiyordu, yani kural hiç eşleşmiyordu.

	   Yapışkan alt bilgi ARTIK BURADA: kabuk dikey bir flex sütunu, gövde
	   boşluğu yutuyor. Eskiden bu iş `body`nin flex'ine bırakılmıştı ama
	   yukarıdaki `display: block !important` onu iptal ediyordu — sonuç,
	   uzun ekranda alt bilgi sayfanın ortasında asılı kalıyordu. */
	.news-app-shell {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		background:
			radial-gradient(circle at top center, rgba(255, 255, 255, 0.05), transparent 0 34%),
			radial-gradient(circle at 20% 0%, rgba(244, 106, 90, 0.08), transparent 0 22%),
			var(--news-bg);
		color: var(--news-text);
	}
	/* Masthead bir KART: ortalanmış, kenarlıklı, yuvarlak köşeli yüzen çubuk.
	   Bu görünüm uzun süre `BaseLayout`taki global `header { ... }` kuralından
	   geliyordu — blog döneminden kalma, çıplak eleman seçicili bir kural. O
	   kuralı "hayalet" sanıp sildim ve masthead kenardan kenara düz bir bara
	   döndü: markup'ın aynı kalması stilin de aynı kaldığı anlamına gelmiyor.
	   Ölçüler artık burada, adıyla yazılı. */
	.news-masthead {
		position: sticky;
		top: 0;
		z-index: 30;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.75rem;
		width: calc(100% - 2rem);
		max-width: 900px;
		margin: 1rem auto;
		padding: 1rem 1.5rem;
		/* Koyu temada `rgba(5,5,5,0.9)` ile birebir aynı değer — fark yok,
		   ama artık zemine bağlı, aydınlık temada elle tekrarlanmıyor. */
		background: color-mix(in srgb, var(--news-bg) 90%, transparent);
		backdrop-filter: blur(14px);
		border: 1px solid color-mix(in srgb, var(--news-border) 88%, transparent);
		border-radius: 1rem;
		box-shadow: var(--news-shadow);
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}
	@media (max-width: 700px) {
		.news-masthead {
			padding: 1rem;
		}
	}
	.news-masthead-wrap,
	.news-hero,
	.news-body {
		width: min(100%, 1280px);
		margin: 0 auto;
	}
	.news-masthead-wrap {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.85rem;
	}
	.news-masthead-inner {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 1rem;
		padding: 0.16rem 0;
		min-height: 44px;
	}
	.news-top-row {
		display: contents;
	}
	.news-actions.mobile-only {
		display: none;
	}
	.news-actions.desktop-only {
		display: flex;
	}
	.news-brand {
		display: inline-flex;
		align-items: center;
		align-self: center;
		gap: 0.6rem;
		min-width: 0;
		text-decoration: none;
		color: var(--news-text);
		padding-right: 1rem;
		margin-right: 0.2rem;
		border-right: 1px solid color-mix(in srgb, var(--news-border) 82%, transparent);
	}
	.news-brand-mark {
		width: 0.24rem;
		height: 0.9rem;
		border-radius: 999px;
		background: linear-gradient(180deg, #ffffff, #9a9a9a);
		box-shadow: 0 0 0 1px rgba(255,255,255,0.08);
	}
	.news-brand-copy {
		display: flex;
		align-items: center;
		min-width: 0;
	}
	.news-brand strong {
		font-size: 1rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1;
		/* Dar ekranda kısalacak olan MARKA ADI. Düğmeler bölünmez; bir düğme
		   iki satıra düşünce başlık şişiyor ve üst üste biniyor. */
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.news-nav-row {
		display: grid;
		grid-template-columns: 1fr;
		align-items: center;
		gap: 0.45rem;
	}
	.news-nav {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: max-content;
		justify-content: start;
		align-items: center;
		align-self: center;
		gap: 0.16rem;
		overflow-x: auto;
		overflow-y: hidden;
		scrollbar-width: none;
		min-width: 0;
		white-space: nowrap;
		height: 100%;
	}
	.news-nav-edge {
		display: none;
	}
	.news-nav::-webkit-scrollbar {
		display: none;
	}
	.news-nav a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.28rem 0.58rem;
		border-radius: 999px;
		text-decoration: none;
		color: var(--news-muted-strong);
		font-size: 0.82rem;
		font-weight: 700;
		line-height: 1;
		border: 1px solid transparent;
		transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
		white-space: nowrap;
	}
	.news-nav a:hover {
		color: var(--news-text);
		background: rgba(255,255,255,0.04);
	}
	.news-nav a[aria-current='page'] {
		color: var(--news-text);
		background: linear-gradient(180deg, rgba(255,255,255,0.1), rgba(255,255,255,0.06));
		border-color: color-mix(in srgb, var(--news-border) 55%, rgba(255,255,255,0.18));
		box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);
	}
	.news-actions {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 0.45rem;
	}
	.news-actions.outside {
		padding-right: 0.2rem;
		flex-shrink: 0;
	}
	.news-theme-pill,
	.news-action-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		align-self: center;
		white-space: nowrap;
		flex-shrink: 0;
		padding: 0.28rem 0.58rem;
		border: 1px solid color-mix(in srgb, var(--news-border) 88%, transparent);
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--news-muted-strong);
		background: color-mix(in srgb, var(--news-panel) 85%, transparent);
		text-decoration: none;
	}
	.news-theme-pill {
		cursor: pointer;
		font: inherit;
	}
	.news-theme-pill:hover,
	.news-action-pill:hover {
		color: var(--news-text);
		border-color: var(--news-accent);
	}
	/* Aydınlık tema TOKEN'LARI buradan taşındı — tek tanım `BaseLayout`ta.
	   Aşağıda kalanlar token'la ifade edilemeyen bileşen ayrıntıları. */
	:global(html[data-theme='light']) .news-app-shell {
		background: var(--news-bg);
	}
	:global(html[data-theme='light']) .news-masthead {
		border-bottom-color: rgba(145, 126, 100, 0.18);
	}
	:global(html[data-theme='light']) .news-nav a:hover {
		background: rgba(33,24,18,0.045);
	}
	:global(html[data-theme='light']) .news-nav a[aria-current='page'] {
		background: linear-gradient(180deg, rgba(20,18,16,0.08), rgba(20,18,16,0.04));
		border-color: rgba(80, 63, 44, 0.16);
		box-shadow: inset 0 1px 0 rgba(255,255,255,0.55);
	}
	:global(html[data-theme='light']) .news-theme-pill,
	:global(html[data-theme='light']) .news-action-pill {
		background: rgba(255,255,255,0.62);
	}
	:global(html[data-theme='light']) .news-brand-mark {
		background: linear-gradient(180deg, #2c241d, #79624d);
		box-shadow: none;
	}
	:global(html[data-theme='light']) .news-brand {
		border-right-color: rgba(95, 76, 55, 0.14);
	}
	:global(html[data-theme='light']) .news-hero {
		border-bottom-color: rgba(145, 126, 100, 0.18);
	}
	.news-hero {
		display: block;
		padding: 0.62rem 1.25rem 0.24rem;
	}
	.news-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.34rem;
		font-size: 0.66rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--news-accent-soft);
		font-weight: 800;
		margin-bottom: 0.42rem;
	}
	.news-live-dot {
		width: 0.46rem;
		height: 0.46rem;
		border-radius: 999px;
		background: #22c55e;
		box-shadow: 0 0 0 rgba(34, 197, 94, 0.45);
		transform: translateY(-0.06rem);
		animation: news-live-pulse 1.6s ease-out infinite;
	}
	.news-footer {
		border-top: 1px solid color-mix(in srgb, var(--news-border) 88%, transparent);
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--news-panel) 28%, transparent), transparent 38%),
			color-mix(in srgb, var(--news-bg) 94%, #000 6%);
	}
	.news-footer-inner {
		width: min(100%, 1280px);
		margin: 0 auto;
		padding: 1.45rem 1.25rem 1.75rem;
		display: grid;
		grid-template-columns: minmax(220px, 0.9fr) minmax(0, 1.7fr);
		gap: clamp(1.25rem, 4vw, 2.5rem);
		align-items: start;
	}
	.news-footer-brand {
		display: grid;
		gap: 0.45rem;
	}
	.news-footer-kicker {
		color: var(--news-text);
		font-size: 0.92rem;
		font-weight: 850;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.news-footer-brand p {
		margin: 0;
		max-width: 44ch;
		color: var(--news-muted);
		font-size: 0.82rem;
		line-height: 1.55;
	}
	.news-footer-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.news-footer-group {
		display: grid;
		align-content: start;
		gap: 0.42rem;
		min-width: 0;
	}
	.news-footer-group h2 {
		margin: 0 0 0.16rem;
		color: var(--news-muted);
		font-size: 0.68rem;
		font-weight: 850;
		letter-spacing: 0.13em;
		line-height: 1;
		text-transform: uppercase;
	}
	.news-footer-group a {
		display: inline-flex;
		width: fit-content;
		color: var(--news-muted-strong);
		font-size: 0.82rem;
		font-weight: 700;
		line-height: 1.25;
		text-decoration: none;
	}
	.news-footer-group a:hover {
		color: var(--news-accent-soft);
	}
	:global(html[data-theme='light']) .news-footer {
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--news-panel) 48%, transparent), transparent 44%),
			color-mix(in srgb, var(--news-bg) 94%, #fff 6%);
	}
	@keyframes news-live-pulse {
		0% {
			box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.45);
		}
		70% {
			box-shadow: 0 0 0 0.42rem rgba(34, 197, 94, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
		}
	}
	.news-hero h1 {
		font-size: clamp(1.6rem, 2.9vw, 2.3rem);
		line-height: 0.98;
		margin: 0;
		font-weight: 900;
		letter-spacing: -0.055em;
		text-wrap: balance;
		max-width: 12ch;
	}
	.news-summary {
		max-width: 62ch;
		margin-top: 0.46rem;
		color: var(--news-muted-strong);
		font-size: 0.92rem;
		line-height: 1.62;
	}
	.news-body {
		/* Kabuğun boş dikey alanını yutan parça. Alt bilgi böylece kısa
		   sayfalarda da ekranın altına oturuyor. */
		flex: 1;
		padding: 0 1.25rem 2.4rem;
	}
	@media (max-width: 1040px) {
		.news-footer-inner {
			grid-template-columns: 1fr;
		}
		.news-footer-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	@media (max-width: 760px) {
		.news-footer-grid {
			grid-template-columns: 1fr;
			gap: 1.1rem;
		}
	}
	@media (max-width: 920px) {
		.news-masthead-wrap {
			grid-template-columns: 1fr;
		}
		.news-masthead-inner {
			grid-template-columns: 1fr;
			min-height: auto;
			padding-top: 0.35rem;
			padding-bottom: 0.35rem;
		}
		.news-top-row {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			min-width: 0;
		}
		.news-actions.mobile-only {
			display: flex;
		}
		.news-actions.desktop-only {
			display: none;
		}
		.news-nav {
