---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  basePath?: string;
  article?: { author: string; datePublished: string; dateModified: string; section: string; authorProfile?: string };
}

import '../styles/technology.css';

const { title, description, noindex = true, basePath = '/yeni', article } = Astro.props;
const editionDate = new Intl.DateTimeFormat('tr-TR', {
  timeZone: 'Europe/Istanbul', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
}).format(new Date());
// Staging is accessible for QA, but its pages must NEVER be indexed.
const stageBuild = import.meta.env.PUBLIC_HABER_STAGING === 'true';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const pageParam = Astro.url.searchParams.get('sayfa');
if (pageParam && /^[1-9][0-9]*$/u.test(pageParam) && Number(pageParam) > 1
  && Number(pageParam) <= 200) canonical.searchParams.set('sayfa', String(Number(pageParam)));
const canonicalUrl = canonical.toString();
const structuredData = article ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description,
  datePublished: article.datePublished,
  dateModified: article.dateModified,
  articleSection: article.section,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  author: { '@type': 'Organization', name: article.author, ...(article.authorProfile ? { url: article.authorProfile } : {}) },
  publisher: { '@type': 'NewsMediaOrganization', name: 'Equinox Haber' },
  isAccessibleForFree: true,
}).replaceAll('<', '\\u003c') : null;
const categories = [
  { label: 'Yapay Zekâ', slug: 'yapay-zeka' },
  { label: 'Yazılım', slug: 'yazilim' },
  { label: 'Donanım', slug: 'donanim' },
  { label: 'Siber Güvenlik', slug: 'siber-guvenlik' },
  { label: 'Dijital Dünya', slug: 'dijital-dunya' },
  { label: 'Teknoloji Sektörü', slug: 'teknoloji-sektoru' },
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Equinox Haber</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex || stageBuild ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Equinox Haber RSS" href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.datePublished} />}
    {article && <meta property="article:modified_time" content={article.dateModified} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#fbfaf7" />
    <script is:inline>
      (() => {
        // Run in <head>, before styles paint. A saved dark preference must
        // never briefly render the article on a light background.
        const root = document.documentElement;
        try {
          const saved = localStorage.getItem('equinox-haber-theme');
          if (saved === 'light' || saved === 'dark') root.dataset.tbTheme = saved;
        } catch {}
        const dark = root.dataset.tbTheme === 'dark'
          || (!root.dataset.tbTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          'content', dark ? '#171a19' : '#fbfaf7',
        );
      })();
    </script>
    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a href="#ana-icerik" class="tb-skip">Ana içeriğe geç</a>
    <header class="ep-header">
      <div class="ep-utility ep-container">
        <time class="ep-edition-date">{editionDate}</time>
        <span class="ep-utility-label">Bağımsız teknoloji yayını</span>
        <div class="ep-utility-actions">
          <a href="/rss.xml" aria-label="RSS akışı">RSS</a>
          <a href="https://orbit.sametbasbug.dev/" rel="external">Orbit ↗</a>
          <button type="button" class="ep-theme" data-theme-toggle aria-label="Renk temasını değiştir" aria-pressed="false">Tema <span aria-hidden="true">◐</span></button>
        </div>
      </div>
      <div class="ep-masthead ep-container">
        <a class="ep-wordmark" href={`${basePath}/`} aria-label="Equinox Haber ana sayfa">EQUINOX <span>HABER</span></a>
        <div class="ep-masthead-caption">HABERİN KAYNAĞINA YAKIN</div>
      </div>
      <div class="ep-nav-band">
        <nav class="ep-nav ep-container" aria-label="Ana gezinme">
          <a class="ep-nav-first" href={`${basePath}/`} data-topic-link="tumu">Haberler</a>
          {categories.map((category) => (
            <a href={`${basePath}/kategori/${category.slug}/`} data-topic-link={category.slug}>{category.label}</a>
          ))}
          <a href={`${basePath}/masa/`} data-topic-link="masa">Haber Masası</a>
        </nav>
      </div>
    </header>
    <main id="ana-icerik"><slot /></main>
    <footer class="ep-footer">
      <div class="ep-container">
        <div class="ep-footer-head">
          <a class="ep-footer-logo" href="/">EQUINOX <span>HABER</span></a>
          <p>Teknolojiye dair haberler. Doğrulanabilir kaynaklar ve açık yazar kimlikleri.</p>
        </div>
        <nav aria-label="Alt bağlantılar" class="ep-footer-links">
          <a href="/masa/">Yayın Ekibi</a>
          <a href="/editorial-ilkeler/">Yayın İlkeleri</a>
          <a href="/duzeltme-politikasi/">Düzeltme Politikası</a>
          <a href="/hakkimizda/">Hakkımızda</a>
          <a href="/iletisim/">İletişim</a>
        </nav>
        <div class="ep-footer-bottom"><small>© {new Date().getFullYear()} Equinox Haber</small><small>Bir Equinox yayını.</small></div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const stored = localStorage.getItem('equinox-haber-theme');
          if (stored === 'dark' || stored === 'light') root.dataset.tbTheme = stored;
        } catch {}
        const button = document.querySelector('[data-theme-toggle]');
        const themeColor = document.querySelector('meta[name="theme-color"]');
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
        const currentTheme = () => root.dataset.tbTheme || (systemTheme.matches ? 'dark' : 'light');
        const updateThemeAccessibility = () => {
          const dark = currentTheme() === 'dark';
          button?.setAttribute('aria-pressed', String(dark));
          themeColor?.setAttribute('content', dark ? '#171a19' : '#fbfaf7');
        };
        // The system or saved preference may start in dark mode. Keep the
        // toggle state correct BEFORE its first click, including when OS
        // preferences change and no explicit choice was stored.
        updateThemeAccessibility();
        systemTheme.addEventListener?.('change', updateThemeAccessibility);
        button?.addEventListener('click', () => {
          const next = currentTheme() === 'dark' ? 'light' : 'dark';
          root.dataset.tbTheme = next;
          updateThemeAccessibility();
          try { localStorage.setItem('equinox-haber-theme', next); } catch {}
        });
        const pathname = location.pathname.replace(/\/+$/, '') || '/';
        const category = pathname.match(/(?:^|\/)kategori\/([a-z-]+)$/);
        const current = category?.[1]
          ?? (pathname === '/' || pathname === '/yeni' ? 'tumu'
            : /\/(?:arsiv|sayfa\/[1-9][0-9]*)$/.test(pathname) ? 'arsiv'
              : /\/masa$/.test(pathname) ? 'masa' : null);
        // Do not flag the homepage on story or informational pages. The active
        // state must describe where the reader actually is.
        document.querySelectorAll('[data-topic-link]').forEach((link) => {
          if (current && link.getAttribute('data-topic-link') === current) {
            link.setAttribute('aria-current', 'page');
          }
        });
      })();
    </script>
  </body>
</html>
