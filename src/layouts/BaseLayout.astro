---
import { ClientRouter } from 'astro:transitions';
import { getMainSiteUrl } from '../data/newsSite';
interface Props {
	title: string;
	description: string;
	ogImage?: string;
	ogImageAlt?: string;
	noindex?: boolean;
	/** Sayfanın kendi yolu yerine kanonik sayılacak yol. Aynı içeriği iki
	 * adresten sunan sayfalar (arşivin ilk sayfası ile ana sayfa) için. */
	canonicalPath?: string;
	type?: string;
}

const {
	title,
	description,
	ogImage,
	ogImageAlt,
	noindex = false,
	canonicalPath,
	type = 'website',
} = Astro.props;

// SEO Hardening Logic
const finalOgImage = ogImage && typeof ogImage === 'string' && ogImage.trim() !== ''
	? ogImage
	: '/og-default.jpg';

const canonicalURL = new URL(canonicalPath || Astro.url.pathname, Astro.site).toString();

/* Bu kabukta SAYFA BAŞLIĞI YOK ve olmamalı.
 *
 * Bir dönem burada blog döneminden kalma bir header duruyordu: "Samet Başbuğ"
 * logosu, eski gezinme bağlantıları, bozuk emoji taşıyan bir tema düğmesi.
 * Üretime hiç çıkmıyordu — `NewsLayout` hem `hideHeader` geçiyor hem de
 * `#main-header { display: none }` yazıyordu, yani aynı ölü şey iki ayrı
 * mekanizmayla saklanıyordu.
 *
 * Ama ölü değil UYUYORDU. `BaseLayout`u doğrudan kullanan yeni bir sayfa
 * yazdım ve hayalet tasarım ekrana geldi; hangi kabuğun ne çizdiğini bilmeden
 * "temel" adını taşıyan şeyi seçmiştim. Header, betiği ve stilleri
 * kaldırıldı, `hideHeader`/`shellLayout` propları da: tek değer alan bir prop
 * prop değil, saklanmış bir karardır.
 *
 * Başlık `NewsLayout`un işi. Yeni bir sayfa `InfoPageLayout` kullanır. */

const ogImageURL = new URL(finalOgImage, Astro.site).toString();
// Paylaşım kartlarında görselin alternatif metni. Sayfa içindeki hero
// görselleri aria-hidden bir sarmalayıcıda durduğu ve komşu başlık linkinin
// dekoratif tekrarı olduğu için orada alt="" doğrudur; sosyal kartta ise
// görselin yanında okunacak başka bir metin yoktur.
const ogImageAltText = ogImageAlt && ogImageAlt.trim() !== '' ? ogImageAlt.trim() : title;
const rssFeedURL = new URL('/rss.xml', Astro.site).toString();
const mainSiteURL = getMainSiteUrl();
const publicationName = 'Equinox Haber';
const publisherName = 'Samet Başbuğ';
const fullTitle = title === publicationName ? publicationName : `${publicationName} | ${title}`;
---

<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: publicationName,
			url: Astro.site?.toString() ?? 'https://haber.sametbasbug.dev/',
			publisher: {
				"@type": "NewsMediaOrganization",
				name: publicationName,
				url: Astro.site?.toString() ?? 'https://haber.sametbasbug.dev/',
				founder: {
					"@type": "Person",
					name: publisherName,
					url: mainSiteURL,
				},
			},
		})} />

		<!-- SEO Temel Katmanı -->
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" type="application/rss+xml" title="Equinox Haber RSS" href={rssFeedURL} />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:alt" content={ogImageAltText} />
		<meta property="og:locale" content="tr_TR" />
		<meta property="og:site_name" content={publicationName} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={ogImageAltText} />

		<!-- Inter kendi sunucumuzdan.
		     Google Fonts'tan gelirken sayfa ilk saniyede gözle görülür biçimde
		     yeniden diziliyordu: metin önce yedek yazı tipiyle (Windows'ta
		     Arial) çiziliyor, font sonradan gelince satır sayıları değişip
		     kartlar kısalıyordu. Ölçüldü: 275 ms'de kayma, yan kartlar
		     234 px'den 215 px'e iniyordu.

		     Türkçe bunu iki katına çıkarıyordu: `ı` `latin` alt kümesinde ama
		     `ğ ş İ Ğ Ş` `latin-ext`'te, yani tek bir başlık iki ayrı dosyaya
		     bağlıydı ve ikisi ayrı anlarda geliyordu.

		     Inter değişken bir font; üç ağırlık (400/600/800) tek dosyadan
		     geliyor, bu yüzden toplam iki dosya yetiyor. İkisi de `preload`
		     ile HTML'le birlikte isteniyor. `font-display: optional`: font ilk
		     boyamaya yetişemezse o yüklemede HİÇ kullanılmıyor, yani kayma
		     olamaz; önbelleğe girdiği için sonraki ziyaretlerde anında
		     görünüyor. -->
		<!-- Newsreader YALNIZ manşetlerde: haberin başlığı serif, gövdesi ve
		     arayüz sans. Haber sitesinin güveni tipografik karşıtlıktan gelir;
		     her şeyin aynı Inter olması başlığı gövdeden ayırmıyordu.

		     TEK AĞIRLIK (700), değişken sürüm değil. Değişken sürüm iki eksen
		     taşıyor (opsz 6-72 × wght 500-800) ve iki dosya 218 KB ediyordu;
		     statik 700 aynı iş için 39 KB. Manşet tek ağırlık kullanıyor,
		     kalan esneklik bedeli hak etmiyor.

		     Bunun bir sonucu var: serif başlıklara `font-weight: 700`
		     YAZILMALI. 800/900 istenirse tarayıcı yapay kalınlaştırma yapar
		     ve harfler bozulur; ortada o ağırlığı taşıyan bir dosya yok.

		     Alt küme ayrımı ve `font-display: optional` Inter'deki gerekçenin
		     aynısı: `ğ ş İ` `latin-ext`te, `ı` `latin`te. -->
		<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="/fonts/newsreader-latin-ext.woff2" as="font" type="font/woff2" crossorigin>
		<style is:inline>
			@font-face {
				font-family: 'Inter';
				font-style: normal;
				font-weight: 100 900;
				font-display: optional;
				src: url('/fonts/inter-latin-ext.woff2') format('woff2');
				unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
			}
			@font-face {
				font-family: 'Inter';
				font-style: normal;
				font-weight: 100 900;
				font-display: optional;
				src: url('/fonts/inter-latin.woff2') format('woff2');
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
			@font-face {
				font-family: 'Newsreader';
				font-style: normal;
				font-weight: 700;
				font-display: optional;
				src: url('/fonts/newsreader-latin-ext.woff2') format('woff2');
				unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
			}
			@font-face {
				font-family: 'Newsreader';
				font-style: normal;
				font-weight: 700;
				font-display: optional;
				src: url('/fonts/newsreader-latin.woff2') format('woff2');
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
		</style>

		<!-- FOUC engeli: tema ilk paint'ten önce uygulanır -->
		<script is:inline>
			(() => {
				try {
					const saved = localStorage.getItem('theme');
					const theme = saved ?? 'dark';
					document.documentElement.setAttribute('data-theme', theme);
				} catch {
					// localStorage erişimi yoksa varsayılan olarak dark tema uygula
					document.documentElement.setAttribute('data-theme', 'dark');
				}
			})();
		</script>
		<ClientRouter />
	</head>
	<body>
		<div id="progress-bar"></div>

		<!-- Back to Top Button -->
		<button id="back-to-top" class="back-to-top" aria-label="Başa Dön">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>
		</button>

		<!-- Lightbox Overlay -->
		<div id="lightbox" class="lightbox">
			<img id="lightbox-img" src="" alt="" />
		</div>


		<main>
			<slot />
		</main>

		<script is:inline>
			// Tema Yönetimi
			const getTheme = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return 'dark';
			};

			const setTheme = (theme) => {
				document.documentElement.setAttribute('data-theme', theme);
				localStorage.setItem('theme', theme);
			};

			function applyTheme() {
				setTheme(getTheme());
			}

			applyTheme();

			// Header Scroll, Reading Progress & Back to Top
			function handleScroll() {
				const backToTop = document.getElementById('back-to-top');

				if (backToTop) {
					if (window.scrollY > 300) {
						backToTop.classList.add('visible');
					} else {
						backToTop.classList.remove('visible');
					}
				}
			}

			// Lightbox Fonksiyonu
			function initLightbox() {
				const lightbox = document.getElementById('lightbox');
				const lightboxImg = document.getElementById('lightbox-img');
				/* `.prose` ve `.hero-image` blog döneminin sınıflarıydı; bu
				   sitede hiçbir sayfada yoklar, yani büyütme HİÇBİR ŞEYE
				   bağlanmıyordu. Haber gövdesinin gerçek sınıfı
				   `.article-prose`. Bugün gövdelerde görsel yok; bir görsel
				   girdiğinde artık çalışacak. */
				const images = document.querySelectorAll('.article-prose img');

				images.forEach(img => {
					img.style.cursor = 'zoom-in';
					img.addEventListener('click', () => {
						lightboxImg.src = img.src;
						lightbox.classList.add('active');
						document.body.style.overflow = 'hidden';
					});
				});

				lightbox?.addEventListener('click', () => {
					lightbox.classList.remove('active');
					document.body.style.overflow = 'auto';
				});
			}

			// Başa Dön Fonksiyonu
			function initBackToTop() {
				const btn = document.getElementById('back-to-top');
				btn?.addEventListener('click', () => {
					window.scrollTo({ top: 0, behavior: 'smooth' });
				});
			}

			// Bağlantı Kopyalama Fonksiyonu
			function initCopyShare() {
				const btn = document.getElementById('copy-share-link');
				if (btn) {
					btn.addEventListener('click', async () => {
						await navigator.clipboard.writeText(window.location.href);
						const originalInner = btn.innerHTML;
						btn.textContent = 'Kopyalandı';
						setTimeout(() => {
							btn.innerHTML = originalInner;
						}, 2000);
					});
				}
			}

			document.addEventListener('astro:page-load', () => {
				applyTheme();
				initLightbox();
				initCopyShare();
				initBackToTop();
				if (typeof addCopyButtons === 'function') addCopyButtons();
				window.addEventListener('scroll', handleScroll);
				handleScroll();
			});

			if (!window.__themeSwitchPlacementBound) {
				window.__themeSwitchPlacementBound = true;
			}

			document.addEventListener('astro:before-swap', (event) => {
				const currentTheme = document.documentElement.getAttribute('data-theme') || getTheme();
				event.newDocument.documentElement.setAttribute('data-theme', currentTheme);
			});

			document.addEventListener('astro:after-swap', applyTheme);

			document.addEventListener('astro:before-preparation', () => {
				const bar = document.getElementById('progress-bar');
				if (bar) bar.style.width = '30%';
			});

			document.addEventListener('astro:after-preparation', () => {
				const bar = document.getElementById('progress-bar');
				if (bar) {
					bar.style.width = '100%';
					setTimeout(() => { bar.style.width = '0%'; }, 300);
				}
			});

			function addCopyButtons() {
				const codeBlocks = document.querySelectorAll('pre');
				codeBlocks.forEach((codeBlock) => {
					if (codeBlock.querySelector('.copy-button')) return;
					const button = document.createElement('button');
					button.className = 'copy-button';
					button.textContent = 'Kopyala';
					codeBlock.appendChild(button);
					button.addEventListener('click', async () => {
						const code = codeBlock.querySelector('code');
						if (code) {
							await navigator.clipboard.writeText(code.innerText);
							button.textContent = 'Kopyalandı';
							setTimeout(() => { button.textContent = 'Kopyala'; }, 2000);
						}
					});
				});
			}
		</script>
		<style is:global>
			/* TEK RENK SİSTEMİ.
			 *
			 * Burada bir dönem blog döneminden kalma ikinci bir palet duruyordu
			 * (indigo `--accent`, `--card-bg`, noktalı arka plan). Haber paleti
			 * `NewsLayout` içinde ayrıca tanımlanıyor ve eskisini `!important`
			 * ile bastırıyordu. Yani her yeni bileşen iki sistemin arasına
			 * doğuyor, hangisinin kazandığını denemeden bilemiyorduk.
			 *
			 * Artık token'ların TEK tanımı burada. `NewsLayout` yalnız kendi
			 * bileşenlerini boyar, hiçbir şeyi geçersiz kılmaz.
			 *
			 * Varsayılan KOYU: yukarıdaki FOUC betiği kayıt yoksa `dark`
			 * damgalıyor, betik hiç çalışmazsa da `:root` koyu kalıyor —
			 * iki yol da aynı yere çıkıyor. */
			:root {
				--news-bg: #050505;
				--news-panel: #0e0e10;
				--news-panel-strong: #17171a;
				--news-text: #f5f5f3;
				--news-muted: #9f9fa8;
				--news-muted-strong: #d6d6db;
				--news-accent: #f46a5a;
				--news-accent-soft: #ff9a86;
				--news-border: #252529;
				--news-border-soft: rgba(255, 255, 255, 0.08);
				--news-shadow: 0 18px 50px rgba(0, 0, 0, 0.22);

				/* HABER MANŞETİNİN yazı ailesi. Yalnız haberin kendi başlığı
				 * bunu kullanır: haber sayfasının h1'i, ana sayfadaki manşet,
				 * yan sütun kartları ve akış satırlarının başlıkları. Bölüm
				 * başlıkları ("Arşiv", "Son haberler"), arayüz etiketleri,
				 * özetler ve gövde sans kalır — serif her yere yayılırsa
				 * ayırt edicilik kaybolur.
				 *
				 * Kural burada token olarak duruyor ama UYGULANDIĞI yer
				 * bileşenin kendi stil bloğu: Astro'nun kapsamlı seçicileri
				 * buradaki global bir kuraldan daha yüksek öncelikli, yani
				 * merkezden dayatmaya çalışmak sessizce etkisiz kalırdı. */
				--news-serif: 'Newsreader', Georgia, 'Times New Roman', serif;
			}

			html[data-theme="light"] {
				--news-bg: #f4efe7;
				--news-panel: #fbf7f0;
				--news-panel-strong: #efe7da;
				--news-text: #141210;
				--news-muted: #6e665d;
				--news-muted-strong: #312c27;
				--news-accent: #bf4a3b;
				--news-accent-soft: #9e3f33;
				--news-border: #d7ccbc;
				--news-border-soft: rgba(24, 18, 12, 0.08);
				--news-shadow: 0 18px 44px rgba(44, 32, 18, 0.08);
			}

			/* Takma adlar: `denetim.astro` ve masthead gölgesi bu adları
			 * kullanıyor. Değer değil, yönlendirme taşıyorlar — tema
			 * değiştiğinde kendiliğinden takip ediyorlar. */
			:root {
				--bg: var(--news-bg);
				--text: var(--news-text);
				--accent: var(--news-accent);
				--secondary: var(--news-muted);
				--border: var(--news-border);
				--shadow: var(--news-shadow);
			}

			* { box-sizing: border-box; margin: 0; padding: 0; }
			html {
				overflow-y: scroll;
				scroll-behavior: smooth;
				scrollbar-width: thin;
				scrollbar-color: color-mix(in srgb, var(--news-accent) 32%, transparent) transparent;
			}

			/* Chromium / Safari / Edge */
			::-webkit-scrollbar { width: 8px; height: 8px; }
			::-webkit-scrollbar-track { background: transparent; }
			::-webkit-scrollbar-thumb {
				background: color-mix(in srgb, var(--news-accent) 32%, transparent);
				border-radius: 10px;
			}
			::-webkit-scrollbar-thumb:hover {
				background: color-mix(in srgb, var(--news-accent) 80%, transparent);
			}
			::-webkit-scrollbar-corner { background: transparent; }

			/* Noktalı arka plan KALDIRILDI: blog dönemi dekoruydu, haber
			 * yüzeyinde `NewsLayout` zaten `background-image: none` ile
			 * siliyordu. Yani ekranda hiç görünmüyor, yalnız silinmesi
			 * gerekiyordu. */
			body {
				font-family: 'Inter', sans-serif;
				background-color: var(--news-bg);
				color: var(--news-text);
				line-height: 1.7;
				min-height: 100vh;
				transition: background-color 0.3s ease;
			}

			#progress-bar {
				position: fixed; top: 0; left: 0; width: 0%; height: 3px;
				background: linear-gradient(to right, var(--news-accent), var(--news-accent-soft));
				z-index: 9999; transition: width 0.3s ease;
			}


			/* Back to Top Button */
			.back-to-top {
				position: fixed; bottom: 2rem; right: 2rem;
				width: 3.5rem; height: 3.5rem;
				background: var(--news-accent); color: #fff;
				border: none; border-radius: 50%;
				display: flex; align-items: center; justify-content: center;
				cursor: pointer; z-index: 99;
				opacity: 0; visibility: hidden;
				transform: translateY(20px);
				transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
				box-shadow: var(--shadow);
			}
			.back-to-top.visible { opacity: 1; visibility: visible; transform: translateY(0); }
			.back-to-top:hover { background: var(--news-accent-soft); transform: translateY(-5px); }

			/* Lightbox Styles */
			.lightbox {
				position: fixed; top: 0; left: 0; width: 100%; height: 100%;
				background: rgba(0, 0, 0, 0.9);
				display: flex; align-items: center; justify-content: center;
				z-index: 10000; opacity: 0; pointer-events: none;
				transition: opacity 0.3s ease;
				backdrop-filter: blur(5px);
			}
			.lightbox.active { opacity: 1; pointer-events: auto; }
			.lightbox img { max-width: 90%; max-height: 90%; border-radius: 0.5rem; transform: scale(0.9); transition: transform 0.3s ease; }
			.lightbox.active img { transform: scale(1); }

			/* `main` ARTIK BİÇİMSİZ.
			 *
			 * Burada 850px'lik bir sarmalayıcı, iç boşluk ve bir giriş
			 * animasyonu vardı; `NewsLayout` üçünü de `!important` ile geri
			 * alıyordu. Yani ölçüyü gerçekte hep sayfa kabuğu belirliyordu,
			 * bu satır yalnız onu bir kez daha ezdirmek için duruyordu.
			 * Genişliği artık her kabuk kendi adıyla söylüyor. */

			h1, h2, h3 { line-height: 1.3; margin-bottom: 1.5rem; color: var(--news-text); font-weight: 800; }

			.emoji { -webkit-text-fill-color: initial; }
			a { color: var(--news-accent); text-decoration: none; }

			/* Kod bloğu her iki temada da KOYU kalır: sözdizimi renkleri koyu
			 * zemine göre üretiliyor, aydınlık zemine taşınınca okunmuyor. */
			pre { position: relative; padding: 1.5rem !important; border: 1px solid var(--news-border) !important; background: #17171a !important; color: #f5f5f3; box-shadow: inset 0 2px 4px 0 rgb(0 0 0 / 0.1); border-radius: 1rem; }
			.copy-button { position: absolute; top: 0.75rem; right: 0.75rem; padding: 0.4rem 0.8rem; background: var(--news-accent); color: #fff; border: none; border-radius: 0.5rem; font-size: 0.75rem; font-weight: 600; cursor: pointer; opacity: 0; transition: all 0.2s ease; }
			pre:hover .copy-button { opacity: 1; }
		</style>
	</body>
