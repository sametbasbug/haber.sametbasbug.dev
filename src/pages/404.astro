---
import TechnologyLayout from '../layouts/TechnologyLayout.astro';
import { getMainSiteUrl } from '../data/newsSite';

const title = '404: Sayfa bulunamadı';
const description = 'Aradığın sayfa bulunamadı. Güncel teknoloji haberleri ve tarihsel arşive geri dönebilirsin.';
---

<TechnologyLayout title={title} description={description} basePath="" noindex={true}>
  <div class="missing">
    <span class="eyebrow">KAYIP SAYFA / 404</span>
    <h1>Burada bir şey <em>yok.</em></h1>
    <p>Bağlantı yanlış yazılmış, içerik geri çekilmiş veya aradığın sayfa taşınmış olabilir. Güncel teknoloji gündemi hâlâ burada.</p>
    <nav aria-label="Alternatif bağlantılar">
      <a class="primary" href="/">Teknoloji haberleri</a>
      <a href="/arsiv/">Tarihsel arşiv</a>
      <a href="/rss.xml">RSS akışı</a>
      <a href={getMainSiteUrl()}>Ana site</a>
    </nav>
  </div>
</TechnologyLayout>
<style>
  .missing{max-width:1080px;margin:auto;padding:clamp(60px,10vw,135px) 28px 140px}
  .eyebrow{font-size:11px;font-weight:800;letter-spacing:.1em;color:var(--tb-accent)}
  h1{margin:18px 0;font-size:clamp(42px,8vw,94px);letter-spacing:-.065em;line-height:1.07}
  h1 em{font-style:normal;color:var(--tb-accent)}
  p{font-size:17px;line-height:1.7;color:var(--tb-muted);max-width:650px}
  nav{display:flex;flex-wrap:wrap;gap:15px;margin-top:35px;align-items:center}
  nav a{color:var(--tb-accent);font-size:13px;font-weight:750;text-decoration:none}
  nav a:hover{text-decoration:underline}
  nav .primary{padding:12px 18px;border-radius:8px;background:var(--tb-ink);color:var(--tb-bg)}
  @media(max-width:480px){.missing{padding:60px 18px 100px}}
</style>
