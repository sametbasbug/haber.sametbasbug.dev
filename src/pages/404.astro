---
import NewsLayout from '../layouts/NewsLayout.astro';
import { getEquinoxHaberCategories } from '../data/equinoxHaber';
import { getMainSiteUrl, getNewsHomeHref } from '../data/newsSite';

const title = '404';
const description = 'Aradığın sayfa haber akışında yok ya da taşınmış olabilir.';
const newsHomeHref = getNewsHomeHref();
const blogHomeHref = getMainSiteUrl();
const categories = getEquinoxHaberCategories();
---

<NewsLayout
	title={title}
	description={description}
	pageTitle={title}
	pageDescription={description}
	categories={categories}
	activeCategory="Tümü"
	hidePageHero={true}
	noindex={true}
>
	<section class="news-404" aria-labelledby="not-found-title">
		<div class="news-404__meta">Sayfa kayıp</div>
		<h1 id="not-found-title">404</h1>
		<p>Aradığın sayfa burada değil. Link eskimiş olabilir ya da haber çoktan başka bir adrese taşınmış olabilir.</p>

		<div class="news-404__actions" aria-label="404 yönlendirmeleri">
			<a href={newsHomeHref} class="primary">Equinox Haber ana sayfası</a>
			<a href="/rss.xml">RSS akışı</a>
			<a href={blogHomeHref}>Ana siteye dön</a>
		</div>
	</section>
</NewsLayout>

<style>
	.news-404 {
		width: min(100%, 760px);
		margin: 0 auto;
		padding: clamp(3.25rem, 9vw, 7rem) 0 clamp(3rem, 8vw, 6rem);
		color: var(--news-text);
	}
	.news-404::before {
		content: '';
		display: block;
		width: 3.2rem;
		height: 1px;
		margin-bottom: 0.95rem;
		background: var(--news-accent);
	}
	.news-404__meta {
		margin-bottom: 0.45rem;
		color: var(--news-accent-soft);
		font-size: 0.72rem;
		font-weight: 820;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}
	.news-404 h1 {
		margin: 0;
		font-size: clamp(5rem, 18vw, 10rem);
		line-height: 0.86;
		font-weight: 900;
		letter-spacing: -0.09em;
	}
	.news-404 p {
		margin: 1.15rem 0 0;
		max-width: 52ch;
		color: var(--news-muted-strong);
		font-size: 1rem;
		line-height: 1.72;
	}
	.news-404__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 1.45rem;
	}
	.news-404__actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.55rem;
		padding: 0.68rem 1rem;
		border: 1px solid color-mix(in srgb, var(--news-border) 82%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--news-panel) 92%, transparent);
		color: var(--news-text);
		font-size: 0.9rem;
		font-weight: 800;
		text-decoration: none;
		transition: 160ms ease;
	}
	.news-404__actions a:hover {
		border-color: color-mix(in srgb, var(--news-accent) 70%, transparent);
		color: var(--news-text);
		transform: translateY(-1px);
	}
	.news-404__actions a.primary {
		border-color: transparent;
		background: var(--news-accent);
		color: white;
	}
	.news-404__actions a.primary:hover {
		background: color-mix(in srgb, var(--news-accent) 88%, white);
	}
	@media (max-width: 640px) {
		.news-404 {
			padding-top: 2.6rem;
		}
		.news-404__actions {
			display: grid;
			grid-template-columns: 1fr;
		}
		.news-404__actions a {
			width: 100%;
		}
	}
</style>
