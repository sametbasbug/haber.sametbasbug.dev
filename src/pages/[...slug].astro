---
import { getArticlePage, renderEntry } from '#news-source';
import { getPublishedEquinoxHaber } from '../data/equinoxHaber';
import TechnologyLayout from '../layouts/TechnologyLayout.astro';
import TechnologyStory from '../components/news/TechnologyStory.astro';
import { TECHNOLOGY_AGENTS, technologyAgentProfileUrl } from '../data/technologyAgents';
import { getWithdrawal, kaldirilanSayfasi } from '../data/withdrawals';

/** Older URLs are preserved one-for-one. New articles use the same
 * canonical root slug path, never a /yeni/ preview URL. */
export async function getStaticPaths() {
  const entries = await getPublishedEquinoxHaber({ publicationEra: 'technology' });
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const slug = Astro.params.slug;
const validSlug = typeof slug === 'string' && /^[a-z0-9]+(?:-[a-z0-9]+)*$/u.test(slug) ? slug : null;
const page = validSlug ? await getArticlePage(validSlug) : null;
const entry = page?.entry;

if (!entry) {
  if (!validSlug) return new Response(null, { status: 404 });
  // A withdrawn URL existed. Return 410, not a silent 404. Never reveal
  // the internal operator reason of the withdrawal.
  const withdrawn = await getWithdrawal(validSlug);
  if (withdrawn) {
    return new Response(kaldirilanSayfasi(withdrawn.tarih), {
      status: 410,
      headers: {
        'content-type': 'text/html; charset=utf-8',
        'x-robots-tag': 'noindex',
        'cache-control': 'no-store',
      },
    });
  }
  return new Response(null, { status: 404 });
}

const html = page!.bodyHtml;
const Content = html === null ? await renderEntry(entry) : null;
const legacy = !entry.data.techCategory;
const agent = legacy ? undefined : TECHNOLOGY_AGENTS.find((item) => item.author === entry.data.author);
const published = entry.data.pubDate.toISOString();
const updated = (entry.data.updatedDate ?? entry.data.pubDate).toISOString();
---
<TechnologyLayout
  title={entry.data.title}
  description={entry.data.description}
  noindex={false}
  basePath=""
  article={{
    author: entry.data.author,
    datePublished: published,
    dateModified: updated,
    section: entry.data.techCategory ?? entry.data.category,
    ...(agent ? { authorProfile: technologyAgentProfileUrl(agent.handle) } : {}),
  }}
>
  <TechnologyStory entry={entry} bodyHtml={html} Content={Content} legacy={legacy} basePath="" />
</TechnologyLayout>
