---
import TechnologyLayout from '../../layouts/TechnologyLayout.astro';
import TechnologyStory from '../../components/news/TechnologyStory.astro';
import { getArticlePage } from '#news-source';

export async function getStaticPaths() { return []; }
const slug = Astro.params.slug;
const safe = typeof slug === 'string' && /^[a-z0-9]+(?:-[a-z0-9]+)*$/u.test(slug) ? slug : null;
const page = safe ? await getArticlePage(safe) : null;
const entry = page?.entry;
if (!entry?.data.techCategory) return new Response(null, { status: 404 });
---
<TechnologyLayout title={entry.data.title} description={entry.data.description}>
  <TechnologyStory entry={entry} bodyHtml={page?.bodyHtml} basePath="/yeni" />
</TechnologyLayout>
