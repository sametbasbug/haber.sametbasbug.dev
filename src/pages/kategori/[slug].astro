---
/** Görselsiz teknoloji kategori akışları: sayfalama D1 tarafında gerçekleşir. */
import TechnologyLayout from '../../layouts/TechnologyLayout.astro';
import { getPublishedEquinoxHaber, getPublishedEquinoxHaberCount, formatNewsDate } from '../../data/equinoxHaber';
import { lastTechnologyPage, technologyPage } from '../../data/technologyPagination';
import { TECHNOLOGY_CATEGORIES } from '../../../worker/src/technology-contract';

const names: Record<string, string> = {
  'yapay-zeka': 'Yapay Zekâ',
  yazilim: 'Yazılım',
  donanim: 'Donanım',
  'siber-guvenlik': 'Siber Güvenlik',
  'dijital-dunya': 'Dijital Dünya',
  'teknoloji-sektoru': 'Teknoloji Sektörü',
};
export function getStaticPaths() {
  return TECHNOLOGY_CATEGORIES.map((slug) => ({ params: { slug } }));
}

const category = Astro.params.slug ?? '';
if (!(TECHNOLOGY_CATEGORIES as readonly string[]).includes(category)) return new Response(null, { status: 404 });
const count = await getPublishedEquinoxHaberCount({
  publicationEra: 'technology',
  techCategory: category,
});
const page = technologyPage(Astro.url.searchParams.get('sayfa'), lastTechnologyPage(count, 20));
if (page === null) return new Response(null, { status: 404 });
const items = await getPublishedEquinoxHaber({
  publicationEra: 'technology',
  techCategory: category,
  limit: 21,
  offset: (page - 1) * 20,
  includeTags: false,
  includeSources: false,
});
const hasNext = items.length > 20;
const entries = items.slice(0, 20);
const title = names[category];
const base = `/kategori/${category}/`;
---

<TechnologyLayout noindex={false} basePath="" title={title} description={`${title} alanında doğrulanabilir kaynaklarla hazırlanan güncel teknoloji haberleri.`}>
  <div class="category-page">
    <nav class="category-crumb" aria-label="İçerik yolu"><a href="/">Haberler</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
    <header class="category-intro">
      <div class="category-kicker">TEKNOLOJİ / HABERLER</div>
      <h1>{title}</h1>
      <p>{title} alanındaki doğrulanabilir kaynaklarla hazırlanan haberler, yeniden eskiye.</p>
    </header>
    <div class="category-heading"><h2>Haber akışı</h2><span>Sayfa {page}</span></div>
    <div class="list">
      {entries.length === 0 && <div class="category-empty"><strong>Bu başlıkta henüz yeni bir haber yayımlanmadı.</strong><p>Önceki yayınlar için <a href="/arsiv/">tarihsel arşivi</a> inceleyebilirsiniz.</p></div>}
      {entries.map((entry) => (
        <article>
          <div class="meta"><time datetime={entry.data.pubDate.toISOString()}>{formatNewsDate(entry.data.pubDate)}</time> <span>· {entry.data.author.replace(/ AI$/u, '')}</span></div>
          <h3><a href={`/${entry.id}/`}>{entry.data.title}</a></h3>
          <p>{entry.data.description}</p>
        </article>
      ))}
    </div>
    {(page > 1 || hasNext) && (
      <nav class="pager" aria-label="Kategori sayfaları">
        {page > 1 ? <a href={page === 2 ? base : `${base}?sayfa=${page - 1}`}>← Daha yeni</a> : <span />}
        <span>Sayfa {page}</span>
        {hasNext ? <a href={`${base}?sayfa=${page + 1}`}>Daha eski →</a> : <span />}
      </nav>
    )}
  </div>
</TechnologyLayout>

<style>
.category-page{max-width:1320px;margin:auto;padding:0 40px}
.category-crumb{display:flex;align-items:center;gap:10px;margin:25px 0 36px;color:var(--tb-muted);font-size:12px}
.category-crumb a{text-decoration:none}.category-crumb a:hover{color:var(--tb-accent)}
.category-crumb span[aria-hidden]{color:var(--tb-line)}
.category-intro{border-bottom:2px solid var(--ep-heavy-rule);padding-bottom:36px}
.category-kicker{font-size:11px;letter-spacing:.11em;font-weight:700;color:var(--tb-accent)}
.category-intro h1{font:700 clamp(45px,5vw,65px)/1.15 Georgia,serif;letter-spacing:-.035em;margin:12px 0}
.category-intro p{color:var(--tb-muted);font-size:15px;max-width:750px;line-height:1.75;margin:0}
.category-heading{max-width:860px;display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:24px 0 14px;border-bottom:1px solid var(--tb-line)}
.category-heading h2{font:700 22px Georgia,serif;margin:0}
.category-heading span{font-size:12px;color:var(--tb-muted)}
.list{max-width:860px}
article{border-bottom:1px solid var(--tb-line);padding:23px 0}
.meta{display:flex;gap:10px;color:var(--tb-muted);font-size:11px}
article h3{font:700 clamp(23px,2.6vw,30px)/1.25 Georgia,serif;letter-spacing:-.02em;margin:9px 0}
article h3 a{text-decoration:none}article h3 a:hover{color:var(--tb-accent)}
article p{color:var(--tb-muted);line-height:1.65;font-size:14px;margin:0}
.category-empty{padding:26px 0 28px;border-bottom:1px solid var(--tb-line);font-size:14px}
.category-empty p{margin:8px 0 0;color:var(--tb-muted)}
.category-empty a,.pager a{color:var(--tb-accent)}
.pager{max-width:860px;display:flex;justify-content:space-between;gap:20px;padding:27px 0;color:var(--tb-muted);font-size:13px}
.pager a{font-weight:650}
@media(max-width:900px){.category-page{padding:0 24px}}
@media(max-width:620px){.category-page{padding:0 18px}.category-crumb{margin:20px 0 24px}.category-intro h1{font-size:42px}.category-intro{padding-bottom:27px}}
</style>
