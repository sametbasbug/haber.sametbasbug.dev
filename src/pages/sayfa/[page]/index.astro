---
import type { GetStaticPaths, Page } from 'astro';
import NewsLayout from '../../../layouts/NewsLayout.astro';
import NewsStream from '../../../components/news/NewsStream.astro';
import { EQUINOX_HABER_PAGE_SIZE, getEquinoxHaberCategories, getPublishedEquinoxHaber, type EquinoxHaberEntry } from '../../../data/equinoxHaber';

export const getStaticPaths = (async ({ paginate }) => {
	const entries = await getPublishedEquinoxHaber();
	return paginate(entries, { pageSize: EQUINOX_HABER_PAGE_SIZE }).filter((page) => page.params.page !== '1');
}) satisfies GetStaticPaths;

interface Props {
	page: Page<EquinoxHaberEntry>;
}

const { page } = Astro.props as Props;
const categories = getEquinoxHaberCategories();
const currentPage = page.currentPage;
const totalPages = page.lastPage;

const title = `Equinox Haber | Sayfa ${currentPage}`;
const description = `Equinox Haber arşivi, sayfa ${currentPage}. Kısa ve okunaklı haber akışının devamı.`;
---

<NewsLayout
	title={title}
	description={description}
	pageTitle={`Equinox Haber · Sayfa ${currentPage}`}
	pageDescription="Bu sayfa, ana akışın devam paketidir. Infinite scroll altında gerçek sayfalama çalışır."
	categories={categories}
	activeCategory="Tümü"
>
	<section class="news-page-wrap">
		<div class="news-page-main">
			<NewsStream entries={page.data} currentPage={currentPage} totalPages={totalPages} />
		</div>
	</section>
</NewsLayout>

<style>
	.news-page-wrap {
		padding-top: 1rem;
	}
	.news-page-main {
		max-width: 100%;
	}
</style>
