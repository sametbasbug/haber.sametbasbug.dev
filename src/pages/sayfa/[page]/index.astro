---
/**
 * Historic /sayfa/N URLs are not discarded, redirected or reindexed as new
 * technology content. Only the 580 legacy records are paginated here.
 * The same visual archive component is used by /arsiv.
 */
import type { GetStaticPaths, Page } from 'astro';
import TechnologyLayout from '../../../layouts/TechnologyLayout.astro';
import TechnologyArchiveList from '../../../components/news/TechnologyArchiveList.astro';
import {
  EQUINOX_HABER_ARCHIVE_PAGE_SIZE,
  getPublishedEquinoxHaber,
  getPublishedEquinoxHaberCount,
  type EquinoxHaberEntry,
} from '../../../data/equinoxHaber';

export const getStaticPaths = (async ({ paginate }) => {
  const entries = await getPublishedEquinoxHaber({ publicationEra: 'legacy' });
  return paginate(entries, { pageSize: EQUINOX_HABER_ARCHIVE_PAGE_SIZE });
}) satisfies GetStaticPaths;

interface Props { page: Page<EquinoxHaberEntry> }
let { page } = Astro.props as Props;

if (!page) {
  const size = EQUINOX_HABER_ARCHIVE_PAGE_SIZE;
  const total = await getPublishedEquinoxHaberCount({ publicationEra: 'legacy' });
  const lastPage = Math.max(1, Math.ceil(total / size));
  const requested = Number(Astro.params.page ?? 1);
  if (!Number.isSafeInteger(requested) || requested < 1 || requested > lastPage) {
    return new Response(null, { status: 404 });
  }
  const entries = await getPublishedEquinoxHaber({
    publicationEra: 'legacy',
    limit: size,
    offset: (requested - 1) * size,
    includeTags: false,
    includeSources: false,
  });
  page = { data: entries, currentPage: requested, lastPage } as Props['page'];
}

const current = page.currentPage;
const last = page.lastPage;
const title = current === 1 ? 'Tarihsel arşiv' : `Tarihsel arşiv, sayfa ${current}`;
---
<TechnologyLayout title={title}
  description={`Equinox Haber tarihsel arşivi. Önceki dönem yayınları, sayfa ${current} / ${last}.`}
  noindex={false} basePath="">
  <TechnologyArchiveList entries={page.data} page={current} hasMore={current < last}
    newerHref={current > 1 ? `/sayfa/${current - 1}/` : null}
    olderHref={current < last ? `/sayfa/${current + 1}/` : null} />
</TechnologyLayout>
