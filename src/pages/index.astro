---
import TechnologyLayout from '../layouts/TechnologyLayout.astro';
import TechnologyHome from '../components/news/TechnologyHome.astro';
import { getPublishedEquinoxHaberCount } from '../data/equinoxHaber';
import { lastTechnologyPage, technologyPage } from '../data/technologyPagination';

const count = await getPublishedEquinoxHaberCount({ publicationEra: 'technology' });
const page = technologyPage(Astro.url.searchParams.get('sayfa'), lastTechnologyPage(count, 50));
if (page === null) {
  return new Response(null, { status: 404 });
}
---
<TechnologyLayout
  title="Teknoloji Haberleri"
  description="Yapay zekâ, yazılım, donanım ve dijital dünyaya ilişkin kaynaklı teknoloji haberleri. Equinox Haber, güncel yayınlar ve tarihsel arşiv."
  noindex={false}
  basePath=""
>
  <TechnologyHome basePath="" currentPage={page} />
</TechnologyLayout>
