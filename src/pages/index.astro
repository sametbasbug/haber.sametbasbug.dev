---
import NewsLayout from '../layouts/NewsLayout.astro';
import {
	EQUINOX_HABER_PAGE_SIZE,
	formatNewsDate,
	getEquinoxHaberCategories,
	getNewsCategoryToken,
	getPublishedEquinoxHaber,
	slugifyNewsCategory,
	type EquinoxHaberEntry,
} from '../data/equinoxHaber';
import { getNewsArticleHref, getNewsArchiveHref, getNewsHomePath } from '../data/newsSite';
import { findAuthorByName } from '../data/authors';
import NewsCard from '../components/news/NewsCard.astro';

const allEntries = await getPublishedEquinoxHaber();
const categories = getEquinoxHaberCategories();
const title = 'Equinox Haber';
const description = "Kaynaklı, kısa ve okunaklı Türkçe haber akışı. Asteria AI ve Selene AI tarafından desteklenir, Samet Başbuğ tarafından yönetilir.";

interface LeadPanelItem {
	id: string;
	href: string;
	title: string;
	description: string;
	heroImage: string;
	category: string;
	categoryToken: string;
	breaking: boolean;
	pubDateIso: string;
	pubDateLabel: string;
	author: string;
}

interface SidePanelItem {
	id: string;
	href: string;
	title: string;
	description: string;
	category: string;
	categoryToken: string;
	pubDateIso: string;
	pubDateLabel: string;
}

/** Akış satırı `NewsCard` ile aynı alanları taşır; ikisi aynı kartı
 * çiziyor, biri sunucuda biri tarayıcıda. */
interface StreamPanelItem {
	id: string;
	href: string;
	title: string;
	description: string;
	heroImage: string;
	category: string;
	categoryToken: string;
	breaking: boolean;
	pubDateIso: string;
	pubDateLabel: string;
	author: string;
	authorRole: string;
}

interface HomePanel {
	leadEntry: LeadPanelItem | null;
	sideEntries: SidePanelItem[];
	streamEntries: StreamPanelItem[];
	sideEyebrow: string;
	sideTitle: string;
}

/* MANŞET ARTIK TEK.
 *
 * Burada 10 haber vardı ama dokuzu gizli slayttı; okuyucu numaralı bir
 * sayaçla tek tek çevirmedikçe yalnız birini görüyordu. Yan sütundaki üçle
 * birlikte ana sayfada tıklamadan görülen haber sayısı DÖRT'tü — 587
 * haberlik bir arşivin vitrini için az. Asıl liste `/sayfa/1`'de duruyordu
 * ve oraya giden bağlantı yalnız alt bilgideydi.
 *
 * Yerine: bir manşet, yanında üç seçilmiş haber, altında arşivdekiyle aynı
 * satır düzeninde 12 başlık. Görülen haber sayısı 4 → 16. */
const SIDE_SLOT_COUNT = 3;
const STREAM_SLOT_COUNT = 12;
const RECENT_SIGNAL_HOURS = 48;
const STALE_SIGNAL_HOURS = 24 * 7;
const GLOBAL_SIGNAL_TERMS = [
	'ab',
	'abd',
	'avrupa',
	'avrupa birliği',
	'birleşmiş milletler',
	'çin',
	'rusya',
	'ukrayna',
	'israil',
	'iran',
	'nato',
	'fed',
	'ecb',
	'avrupa merkez bankası',
	'openai',
	'google',
	'microsoft',
	'apple',
	'nvidia',
	'nasa',
	'who',
	'dünya sağlık örgütü',
];

function hoursSince(date: Date) {
	return Math.max(0, (Date.now() - date.valueOf()) / 36e5);
}

function escapeRegExp(value: string) {
	return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

/* Kalıplar MODÜL SEVİYESİNDE bir kez derleniyor.
 *
 * Eskiden her `hasGlobalSignal` çağrısında 23 terim için yeniden `RegExp`
 * kuruluyordu. `\p{L}` içeren kalıpların derlenmesi pahalı ve bu fonksiyon
 * istek başına binlerce kez çağrılıyordu. */
const GLOBAL_SIGNAL_PATTERNS = GLOBAL_SIGNAL_TERMS.map(
	(term) => new RegExp(`(^|[^\\p{L}\\p{N}])${escapeRegExp(term)}([^\\p{L}\\p{N}]|$)`, 'u'),
);

function hasGlobalSignal(entry: EquinoxHaberEntry) {
	const haystack = [entry.data.title, entry.data.description, ...(entry.data.tags ?? [])]
		.join(' ')
		.toLocaleLowerCase('tr-TR');
	return GLOBAL_SIGNAL_PATTERNS.some((pattern) => pattern.test(haystack));
}

/* Skorlar istek başına bir kez hesaplanıyor.
 *
 * Sayfa beş panel kuruyor ('Tümü' ve dört kategori) ve her panel kendi
 * listesini sıralıyordu; aynı haber böylece iki kez skorlanıyordu. Skor
 * girdiye göre sabit olduğu için tekrar gereksiz.
 *
 * Önbellek İSTEK BAŞINA: skor `hoursSince` üzerinden zamana bağlı, modül
 * seviyesinde tutulsa isolate yaşadıkça bayatlar ve haberler eskidikçe
 * yanlış sıralanırdı. Astro frontmatter'ı her istekte baştan çalıştığı için
 * bu Map de her istekte taze kuruluyor. */
const signalScoreCache = new Map<string, number>();

function scoreSignalEntry(entry: EquinoxHaberEntry) {
	const cached = signalScoreCache.get(entry.id);
	if (cached !== undefined) return cached;
	const computed = computeSignalScore(entry);
	signalScoreCache.set(entry.id, computed);
	return computed;
}

function computeSignalScore(entry: EquinoxHaberEntry) {
	const ageHours = hoursSince(entry.data.pubDate);
	const sourceCount = entry.data.sources?.length ?? 0;
	let score = 0;

	if (entry.data.editorPick) score += ageHours <= STALE_SIGNAL_HOURS ? 40 : 4;
	if (entry.data.breaking) score += 28;
	if (sourceCount > 1) score += Math.min(18, 8 + sourceCount * 4);
	else if (sourceCount === 1) score += 4;
	if (hasGlobalSignal(entry)) score += 14;

	if (ageHours <= 6) score += 26;
	else if (ageHours <= 24) score += 18;
	else if (ageHours <= RECENT_SIGNAL_HOURS) score += 12;
	else if (ageHours <= STALE_SIGNAL_HOURS) score += 5;
	else score -= Math.min(45, Math.floor((ageHours - STALE_SIGNAL_HOURS) / 24) * 2);

	return score;
}

function selectSideEntries(entries: EquinoxHaberEntry[], options: { diversifyCategories: boolean }) {
	/* Skor SIRALAMADAN ÖNCE bir kez hesaplanıyor.
	 *
	 * Eskiden `scoreSignalEntry` karşılaştırma fonksiyonunun içindeydi; 587
	 * haberlik bir dizide sıralama ~11.400 kez karşılaştırma yapıyor ve her
	 * karşılaştırma iki skor hesaplıyordu. Skor girdiye göre sabit olduğu için
	 * bu iş tekrar tekrar yapılıyordu. Sıra değişmiyor: aynı skorlar, aynı
	 * eşitlik bozma kuralı, sıralama da kararlı. */
	const rankedEntries = entries
		.map((entry) => ({ entry, score: scoreSignalEntry(entry) }))
		.sort((a, b) => {
			const scoreDelta = b.score - a.score;
			if (scoreDelta !== 0) return scoreDelta;
			return b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf();
		})
		.map((ranked) => ranked.entry);

	if (!options.diversifyCategories) return rankedEntries.slice(0, SIDE_SLOT_COUNT);

	const selected: EquinoxHaberEntry[] = [];
	const selectedCategories = new Set<string>();

	for (const entry of rankedEntries) {
		const category = entry.data.category ?? 'default';
		if (selectedCategories.has(category)) continue;
		selected.push(entry);
		selectedCategories.add(category);
		if (selected.length === SIDE_SLOT_COUNT) return selected;
	}

	for (const entry of rankedEntries) {
		if (selected.some((selectedEntry) => selectedEntry.id === entry.id)) continue;
		selected.push(entry);
		if (selected.length === SIDE_SLOT_COUNT) return selected;
	}

	return selected;
}

function buildPanel(entries: EquinoxHaberEntry[], options: { category?: string; diversifyCategories?: boolean } = {}) {
	const firstPageEntries = entries.slice(0, EQUINOX_HABER_PAGE_SIZE);
	const leadEntry = firstPageEntries[0];
	/* Yan sütun manşetin dışından seçiliyor; akış da ikisinin dışından.
	   Aynı haber sayfada iki kez görünmüyor. */
	const sideEntries = selectSideEntries(
		entries.filter((entry) => entry.id !== leadEntry?.id),
		{ diversifyCategories: Boolean(options.diversifyCategories) },
	);
	const usedIds = new Set([leadEntry?.id, ...sideEntries.map((entry) => entry.id)]);
	const streamEntries = firstPageEntries
		.filter((entry) => !usedIds.has(entry.id))
		.slice(0, STREAM_SLOT_COUNT);
	return {
		leadEntry,
		sideEntries,
		streamEntries,
		sideEyebrow: 'Öne çıkanlar',
		sideTitle: options.category && options.category !== 'Tümü' ? `${options.category} akışından` : 'Akıştan seçilenler',
	};
}

/* Aynı eşleme bir dönem iki kez yazılıydı: bir kez 'Tümü' için, bir kez
   kategori döngüsü içinde. Alanları değiştirmek iki yeri birden düzenlemek
   demekti; biri unutulursa fark yalnız o kategoriye tıklandığında görülürdü. */
function toLeadItem(entry: EquinoxHaberEntry): LeadPanelItem {
	return {
		id: entry.id,
		href: getNewsArticleHref(entry.id),
		title: entry.data.title,
		description: entry.data.description,
		heroImage: entry.data.heroImage ?? '',
		category: entry.data.category ?? '',
		categoryToken: getNewsCategoryToken(entry.data.category),
		breaking: Boolean(entry.data.breaking),
		pubDateIso: entry.data.pubDate.toISOString(),
		pubDateLabel: formatNewsDate(entry.data.pubDate),
		author: entry.data.author ?? 'Asteria AI',
	};
}

function toSideItem(entry: EquinoxHaberEntry): SidePanelItem {
	return {
		id: entry.id,
		href: getNewsArticleHref(entry.id),
		title: entry.data.title,
		description: entry.data.description,
		category: entry.data.category ?? '',
		categoryToken: getNewsCategoryToken(entry.data.category),
		pubDateIso: entry.data.pubDate.toISOString(),
		pubDateLabel: formatNewsDate(entry.data.pubDate),
	};
}

function toStreamItem(entry: EquinoxHaberEntry): StreamPanelItem {
	return {
		...toLeadItem(entry),
		authorRole: findAuthorByName(entry.data.author)?.role ?? '',
	};
}

function toPanel(panel: ReturnType<typeof buildPanel>): HomePanel {
	return {
		sideEyebrow: panel.sideEyebrow,
		sideTitle: panel.sideTitle,
		leadEntry: panel.leadEntry ? toLeadItem(panel.leadEntry) : null,
		sideEntries: panel.sideEntries.map(toSideItem),
		streamEntries: panel.streamEntries.map(toStreamItem),
	};
}

const allPanel = buildPanel(allEntries, { category: 'Tümü', diversifyCategories: true });

const panels: Record<string, HomePanel> = { 'Tümü': toPanel(allPanel) };

for (const category of categories) {
	const categoryEntries = allEntries.filter((entry) => entry.data.category === category);
	panels[category] = toPanel(buildPanel(categoryEntries, { category, diversifyCategories: false }));
}

const categorySlugMap = Object.fromEntries(categories.map((category) => [slugifyNewsCategory(category), category]));
const newsHomePath = getNewsHomePath().replace(/\/+$/, '') || '/';
const newsHomeConfigJson = JSON.stringify({
	panels,
	categorySlugMap,
	newsHomePath,
	archiveHref: getNewsArchiveHref(),
	SIDE_SLOT_COUNT,
}).replace(/</g, '\\u003c');
---

<NewsLayout
	title={title}
	description={description}
	pageTitle=""
	pageDescription=""
	categories={categories}
	activeCategory="Tümü"
>
	<div data-news-home-root>
		{allPanel.leadEntry ? (
			<>
			<section class="featured-news-grid">
				<a href={getNewsArticleHref(allPanel.leadEntry.id)} class="featured-lead-card">
					{allPanel.leadEntry.data.heroImage && <img src={allPanel.leadEntry.data.heroImage} alt="" loading="eager" decoding="async" />}
					<div class="featured-overlay lead"></div>
					<div class="featured-lead-content">
						<div class="featured-lead-topline">
							{allPanel.leadEntry.data.category && <span class="featured-badge" data-category={getNewsCategoryToken(allPanel.leadEntry.data.category)}>{allPanel.leadEntry.data.category}</span>}
							{allPanel.leadEntry.data.breaking && <span class="featured-badge breaking">Son Dakika</span>}
						</div>
						<h2>{allPanel.leadEntry.data.title}</h2>
						<p>{allPanel.leadEntry.data.description}</p>
						<div class="featured-meta-row">
							<time datetime={allPanel.leadEntry.data.pubDate.toISOString()}>{formatNewsDate(allPanel.leadEntry.data.pubDate)}</time>
							<span>{allPanel.leadEntry.data.author ?? 'Asteria AI'}</span>
						</div>
					</div>
				</a>

				{allPanel.sideEntries.length > 0 && (
					<section class="featured-side-stack" aria-label={allPanel.sideTitle}>
						<div class="featured-side-header">
							<p>{allPanel.sideEyebrow}</p>
							<h2>{allPanel.sideTitle}</h2>
						</div>
						<div class="featured-side-list" role="list">
							{allPanel.sideEntries.map((entry) => (
								<a href={getNewsArticleHref(entry.id)} class="featured-side-card" role="listitem">
									<div class="featured-side-content text-only">
										{entry.data.category && <span class="featured-badge side" data-category={getNewsCategoryToken(entry.data.category)}>{entry.data.category}</span>}
										<h2>{entry.data.title}</h2>
										<p>{entry.data.description}</p>
										<time datetime={entry.data.pubDate.toISOString()}>{formatNewsDate(entry.data.pubDate)}</time>
									</div>
								</a>
							))}
							{Array.from({ length: Math.max(0, SIDE_SLOT_COUNT - allPanel.sideEntries.length) }).map(() => (
								<div class="featured-side-card featured-side-card-placeholder" aria-hidden="true"></div>
							))}
						</div>
					</section>
				)}
			</section>

			{allPanel.streamEntries.length > 0 && (
				<section class="home-stream" aria-label="Son haberler">
					<div class="home-stream-head">
						<p>Akış</p>
						<h2>Son haberler</h2>
					</div>
					<div class="home-stream-list" data-home-stream-list>
						{allPanel.streamEntries.map((entry) => <NewsCard entry={entry} />)}
					</div>
					<a class="home-stream-more" href={getNewsArchiveHref()}>Arşivin tamamına göz at →</a>
				</section>
			)}
			</>
		) : (
			<div class="news-empty-state">
				<h2>Henüz yayınlanmış haber yok.</h2>
				<p>İskelet hazır. İlk haber girildiğinde bu akış canlı çalışmaya başlayacak.</p>
			</div>
		)}
	</div>
</NewsLayout>

<script is:inline type="application/json" id="news-home-config" set:html={newsHomeConfigJson}></script>

<script>
	type ClientLeadPanelItem = {
		href: string;
		title: string;
		description: string;
		heroImage: string;
		category: string;
		categoryToken: string;
		breaking: boolean;
		pubDateIso: string;
		pubDateLabel: string;
		author: string;
	};

	type ClientSidePanelItem = {
		href: string;
		title: string;
		description: string;
		category: string;
		categoryToken: string;
		pubDateIso: string;
		pubDateLabel: string;
	};

	type ClientStreamPanelItem = ClientLeadPanelItem & { authorRole: string };

	type ClientHomePanel = {
		leadEntry: ClientLeadPanelItem | null;
		sideEntries: ClientSidePanelItem[];
		streamEntries: ClientStreamPanelItem[];
		sideEyebrow: string;
		sideTitle: string;
	};

	type NewsHomeConfig = {
		panels: Record<string, ClientHomePanel>;
		categorySlugMap: Record<string, string>;
		newsHomePath: string;
		archiveHref: string;
		SIDE_SLOT_COUNT: number;
	};

	const newsHomeConfigElement = document.getElementById('news-home-config');
	const newsHomeConfig = (newsHomeConfigElement?.textContent
		? JSON.parse(newsHomeConfigElement.textContent)
		: { panels: {}, categorySlugMap: {}, newsHomePath: '/', archiveHref: '/sayfa/1/', SIDE_SLOT_COUNT: 3 }) as NewsHomeConfig;
	const { panels, categorySlugMap, newsHomePath, archiveHref, SIDE_SLOT_COUNT } = newsHomeConfig;

	function escapeHtml(value = '') {
		return String(value)
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#39;');
	}

	/* Aşağıdaki üç fonksiyon, sayfanın sunucuda basılan markup'ının
	   TARAYICI KOPYASI: kategoriye tıklandığında panel burada yeniden
	   çiziliyor. Sunucudaki karşılıkları sırasıyla `.featured-lead-card`
	   bloğu, `.featured-side-stack` bloğu ve `NewsCard.astro`. Biri
	   değişirse diğeri de değişmeli. */
	function renderLead(item: ClientLeadPanelItem) {
		return `
			<a href="${escapeHtml(item.href)}" class="featured-lead-card">
				${item.heroImage ? `<img src="${escapeHtml(item.heroImage)}" alt="" loading="eager" decoding="async">` : ''}
				<div class="featured-overlay lead"></div>
				<div class="featured-lead-content">
					<div class="featured-lead-topline">
						${item.category ? `<span class="featured-badge" data-category="${escapeHtml(item.categoryToken)}">${escapeHtml(item.category)}</span>` : ''}
						${item.breaking ? '<span class="featured-badge breaking">Son Dakika</span>' : ''}
					</div>
					<h2>${escapeHtml(item.title)}</h2>
					<p>${escapeHtml(item.description)}</p>
					<div class="featured-meta-row">
						<time datetime="${escapeHtml(item.pubDateIso)}">${escapeHtml(item.pubDateLabel)}</time>
						<span>${escapeHtml(item.author)}</span>
					</div>
				</div>
			</a>
		`;
	}

	function renderStreamCard(item: ClientStreamPanelItem) {
		return `
			<article class="news-card" data-news-card data-category="${escapeHtml(item.categoryToken)}">
				<div class="news-card-copy">
					${item.breaking ? '<span class="breaking-pill">SON DAKİKA</span>' : ''}
					<div class="news-card-head">
						${item.category ? `<span class="news-category" data-category="${escapeHtml(item.categoryToken)}">${escapeHtml(item.category)}</span>` : ''}
						<time datetime="${escapeHtml(item.pubDateIso)}">${escapeHtml(item.pubDateLabel)}</time>
					</div>
					<a class="news-card-title" href="${escapeHtml(item.href)}">${escapeHtml(item.title)}</a>
					<p class="news-card-desc">${escapeHtml(item.description)}</p>
					<div class="news-card-meta">
						<span class="news-author">${escapeHtml(item.author)}</span>
						${item.authorRole ? `<span class="news-author-role">${escapeHtml(item.authorRole)}</span>` : ''}
						<a class="news-read-link" href="${escapeHtml(item.href)}">Devamını oku</a>
					</div>
				</div>
				${item.heroImage ? `<a class="news-card-image-link" href="${escapeHtml(item.href)}" aria-hidden="true" tabindex="-1"><img class="news-card-image" src="${escapeHtml(item.heroImage)}" alt="" loading="lazy" decoding="async"></a>` : ''}
			</article>
		`;
	}

	function renderStream(panel: ClientHomePanel) {
		if (panel.streamEntries.length === 0) return '';
		return `
			<section class="home-stream" aria-label="Son haberler">
				<div class="home-stream-head">
					<p>Akış</p>
					<h2>Son haberler</h2>
				</div>
				<div class="home-stream-list" data-home-stream-list>
					${panel.streamEntries.map(renderStreamCard).join('')}
				</div>
				<a class="home-stream-more" href="${escapeHtml(archiveHref)}">Arşivin tamamına göz at →</a>
			</section>
		`;
	}

	function renderSideEntries(panel: ClientHomePanel) {
		const { sideEntries: items } = panel;
		if (items.length === 0) return '';
		const placeholders = Math.max(0, SIDE_SLOT_COUNT - items.length);
		return `
			<section class="featured-side-stack" aria-label="${escapeHtml(panel.sideTitle)}">
				<div class="featured-side-header">
					<p>${escapeHtml(panel.sideEyebrow)}</p>
					<h2>${escapeHtml(panel.sideTitle)}</h2>
				</div>
				<div class="featured-side-list" role="list">
					${items
						.map(
							(item) => `
								<a href="${escapeHtml(item.href)}" class="featured-side-card" role="listitem">
									<div class="featured-side-content text-only">
										${item.category ? `<span class="featured-badge side" data-category="${escapeHtml(item.categoryToken)}">${escapeHtml(item.category)}</span>` : ''}
										<h2>${escapeHtml(item.title)}</h2>
										<p>${escapeHtml(item.description)}</p>
										<time datetime="${escapeHtml(item.pubDateIso)}">${escapeHtml(item.pubDateLabel)}</time>
									</div>
								</a>
							`,
						)
						.join('')}
					${Array.from({ length: placeholders }).map(() => `<div class="featured-side-card featured-side-card-placeholder" aria-hidden="true"></div>`).join('')}
				</div>
			</section>
		`;
	}

	function renderPanel(name: string) {
		const root = document.querySelector('[data-news-home-root]');
		if (!(root instanceof HTMLElement)) return;
		const panel = panels[name] ?? panels['Tümü'];
		if (!panel || !panel.leadEntry) {
			root.innerHTML = `
				<div class="news-empty-state">
					<h2>Bu kategoride henüz yayınlanmış haber yok.</h2>
					<p>İlk kayıt geldiğinde akış burada görünecek.</p>
				</div>
			`;
			return;
		}

		root.innerHTML = `
			<section class="featured-news-grid">
				${renderLead(panel.leadEntry)}
				${renderSideEntries(panel)}
			</section>
			${renderStream(panel)}
		`;
	}

	function syncNav(activeCategory: string) {
		document.querySelectorAll('[data-news-nav] a').forEach((link) => {
			if (!(link instanceof HTMLAnchorElement)) return;
			const label = link.textContent?.trim() || '';
			if (label === activeCategory) link.setAttribute('aria-current', 'page');
			else link.removeAttribute('aria-current');
		});
	}

	function categoryFromUrl(url: URL) {
		const slug = url.searchParams.get('kategori');
		if (!slug) return 'Tümü';
		return categorySlugMap[slug] ?? 'Tümü';
	}

	function applyCategory(category: string, updateUrl = true) {
		renderPanel(category);
		syncNav(category);
		if (updateUrl) {
			const nextUrl = new URL(window.location.href);
			if (category === 'Tümü') nextUrl.searchParams.delete('kategori');
			else {
				const slug = Object.entries(categorySlugMap).find(([, value]) => value === category)?.[0];
				if (slug) nextUrl.searchParams.set('kategori', slug);
			}
			window.history.replaceState({}, '', `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`);
		}
	}

	function initNewsCategoryFilters() {
		const homeRoot = document.querySelector('[data-news-home-root]');
		if (!(homeRoot instanceof HTMLElement)) return;
		if (document.body.dataset.newsCategoryBound === '1') return;
		document.body.dataset.newsCategoryBound = '1';

		applyCategory(categoryFromUrl(new URL(window.location.href)), false);

		document.querySelectorAll('[data-news-nav] a').forEach((link) => {
			if (!(link instanceof HTMLAnchorElement)) return;
			link.addEventListener('click', (event) => {
				const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
				if (currentPath !== newsHomePath) return;
				const url = new URL(link.href, window.location.origin);
				const targetPath = url.pathname.replace(/\/+$/, '') || '/';
				if (targetPath !== newsHomePath) return;
				event.preventDefault();
				applyCategory(categoryFromUrl(url));
			});
		});

		window.addEventListener('popstate', () => {
			if (!document.querySelector('[data-news-home-root]')) return;
			applyCategory(categoryFromUrl(new URL(window.location.href)), false);
		});
	}

	initNewsCategoryFilters();
	document.addEventListener('astro:page-load', () => {
		document.body.dataset.newsCategoryBound = '0';
		initNewsCategoryFilters();
	});
</script>

