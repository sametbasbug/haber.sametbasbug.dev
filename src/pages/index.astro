---
import NewsLayout from '../layouts/NewsLayout.astro';
import {
	EQUINOX_HABER_PAGE_SIZE,
	formatNewsDate,
	getEquinoxHaberCategories,
	getNewsCategoryToken,
	getPublishedEquinoxHaber,
	slugifyNewsCategory,
	type EquinoxHaberEntry,
} from '../data/equinoxHaber';
import { getNewsArticleHref, getNewsArchiveHref, getNewsHomePath } from '../data/newsSite';
import { findAuthorByName } from '../data/authors';
import NewsCard from '../components/news/NewsCard.astro';
import { gorselKaynagi, KART_SIZES, MANSET_SIZES } from '../data/gorsel';

const categories = getEquinoxHaberCategories();
const [allEntries, ...categoryEntrySets] = await Promise.all([
	getPublishedEquinoxHaber({ limit: EQUINOX_HABER_PAGE_SIZE, includeTags: false, includeSources: false }),
	...categories.map((category) => getPublishedEquinoxHaber({
		limit: EQUINOX_HABER_PAGE_SIZE,
		category,
		includeTags: false,
		includeSources: false,
	})),
]);
const categoryEntries = Object.fromEntries(
	categories.map((category, index) => [category, categoryEntrySets[index] ?? []]),
) as Record<string, EquinoxHaberEntry[]>;
const title = 'Equinox Haber';
const description = "Kaynaklı, kısa ve okunaklı Türkçe haber akışı. Asteria AI ve Selene AI tarafından desteklenir, Samet Başbuğ tarafından yönetilir.";

interface LeadPanelItem {
	id: string;
	href: string;
	title: string;
	description: string;
	heroImage: string;
	category: string;
	categoryToken: string;
	breaking: boolean;
	pubDateIso: string;
	pubDateLabel: string;
	author: string;
}

/** Akış satırı `NewsCard` ile aynı alanları taşır; ikisi aynı kartı
 * çiziyor, biri sunucuda biri tarayıcıda. */
interface StreamPanelItem {
	id: string;
	href: string;
	title: string;
	description: string;
	heroImage: string;
	category: string;
	categoryToken: string;
	breaking: boolean;
	pubDateIso: string;
	pubDateLabel: string;
	author: string;
	authorRole: string;
}

interface HomePanel {
	leadEntry: LeadPanelItem | null;
	streamEntries: StreamPanelItem[];
}

/* ANA SAYFA TEK SIRALAMAYLA ÇALIŞIR: bir manşet, altında arşivdekiyle aynı
 * satır düzeninde 12 başlık. Hepsi tarihe göre, kesintisiz.
 *
 * Manşetin yanında "Akıştan seçilenler" diye skora göre seçilmiş üç haberlik
 * bir sütun vardı; KALDIRILDI. Havuzu ön sayfanın bittiği yerden başlıyordu,
 * yani 13. haberden itibaren — site düzenli yayın yapmadığı için bu pratikte
 * yedi hafta geriye düşüyordu. Canlıda 23 Ağustos tarihli bir manşetin
 * yanında 8 Temmuz ve 14 Haziran tarihli haberler "öne çıkanlar" etiketiyle
 * duruyordu. Seçim kuralı işi büyütüyordu: skor sinyali yüksek haberi öne
 * alır, o da en hızlı bayatlayan haberdir ("ateşkes sona erdi" gibi).
 *
 * Sütun bayat değildi, bayat olmak ZORUNDAYDI — tanımı gereği taze olamazdı.
 * Tazelik şartı eklemek de kurtarmazdı; havuz zaten haftalar geriden
 * başladığı için sütun neredeyse her zaman boş kalırdı.
 *
 * Onunla birlikte 132 satırlık skorlama düzeneği de gitti (`scoreSignalEntry`,
 * `hasGlobalSignal`, terim listesi, önbellek). Başka çağıranı yoktu. */
const STREAM_SLOT_COUNT = 12;

function buildPanel(entries: EquinoxHaberEntry[]) {
	const firstPageEntries = entries.slice(0, EQUINOX_HABER_PAGE_SIZE);
	const leadEntry = firstPageEntries[0];

	/* "Son haberler" kronolojik bir listedir; içinde delik olamaz. Manşetten
	   sonraki en taze N haber, kesintisiz. */
	const streamEntries = firstPageEntries
		.filter((entry) => entry.id !== leadEntry?.id)
		.slice(0, STREAM_SLOT_COUNT);
	return { leadEntry, streamEntries };
}

/* Aynı eşleme bir dönem iki kez yazılıydı: bir kez 'Tümü' için, bir kez
   kategori döngüsü içinde. Alanları değiştirmek iki yeri birden düzenlemek
   demekti; biri unutulursa fark yalnız o kategoriye tıklandığında görülürdü. */
function toLeadItem(entry: EquinoxHaberEntry): LeadPanelItem {
	return {
		id: entry.id,
		href: getNewsArticleHref(entry.id),
		title: entry.data.title,
		description: entry.data.description,
		heroImage: entry.data.heroImage ?? '',
		category: entry.data.category ?? '',
		categoryToken: getNewsCategoryToken(entry.data.category),
		breaking: Boolean(entry.data.breaking),
		pubDateIso: entry.data.pubDate.toISOString(),
		pubDateLabel: formatNewsDate(entry.data.pubDate),
		author: entry.data.author ?? 'Asteria AI',
	};
}

function toStreamItem(entry: EquinoxHaberEntry): StreamPanelItem {
	return {
		...toLeadItem(entry),
		authorRole: findAuthorByName(entry.data.author)?.role ?? '',
	};
}

function toPanel(panel: ReturnType<typeof buildPanel>): HomePanel {
	return {
		leadEntry: panel.leadEntry ? toLeadItem(panel.leadEntry) : null,
		streamEntries: panel.streamEntries.map(toStreamItem),
	};
}

const allPanel = buildPanel(allEntries);
const mansetGorseli = allPanel.leadEntry?.data.heroImage
	? gorselKaynagi(allPanel.leadEntry.data.heroImage, MANSET_SIZES)
	: null;

const panels: Record<string, HomePanel> = { 'Tümü': toPanel(allPanel) };

for (const category of categories) {
	panels[category] = toPanel(buildPanel(categoryEntries[category] ?? []));
}

const categorySlugMap = Object.fromEntries(categories.map((category) => [slugifyNewsCategory(category), category]));
const newsHomePath = getNewsHomePath().replace(/\/+$/, '') || '/';
const newsHomeConfigJson = JSON.stringify({
	panels,
	categorySlugMap,
	newsHomePath,
	archiveHref: getNewsArchiveHref(),
}).replace(/</g, '\\u003c');
---

<NewsLayout
	title={title}
	description={description}
	pageTitle=""
	pageDescription=""
	categories={categories}
	activeCategory="Tümü"
>
	<div data-news-home-root>
		{allPanel.leadEntry ? (
			<>
			<section class="featured-news-grid">
				<a href={getNewsArticleHref(allPanel.leadEntry.id)} class="featured-lead-card">
					{mansetGorseli && (
						<img
							src={mansetGorseli.src}
							srcset={mansetGorseli.srcset}
							sizes={mansetGorseli.sizes}
							width="1200"
							height="675"
							alt=""
							loading="eager"
							decoding="async"
						/>
					)}
					<div class="featured-overlay lead"></div>
					<div class="featured-lead-content">
						<div class="featured-lead-topline">
							{allPanel.leadEntry.data.category && <span class="featured-badge" data-category={getNewsCategoryToken(allPanel.leadEntry.data.category)}>{allPanel.leadEntry.data.category}</span>}
							{allPanel.leadEntry.data.breaking && <span class="featured-badge breaking">Son Dakika</span>}
						</div>
						<h2>{allPanel.leadEntry.data.title}</h2>
						<p>{allPanel.leadEntry.data.description}</p>
						<div class="featured-meta-row">
							<time datetime={allPanel.leadEntry.data.pubDate.toISOString()}>{formatNewsDate(allPanel.leadEntry.data.pubDate)}</time>
							<span>{allPanel.leadEntry.data.author ?? 'Asteria AI'}</span>
						</div>
					</div>
				</a>
			</section>

			{allPanel.streamEntries.length > 0 && (
				<section class="home-stream" aria-label="Son haberler">
					<div class="home-stream-head">
						<p>Akış</p>
						<h2>Son haberler</h2>
					</div>
					<div class="home-stream-list" data-home-stream-list>
						{allPanel.streamEntries.map((entry) => <NewsCard entry={entry} />)}
					</div>
					<a class="home-stream-more" href={getNewsArchiveHref()}>Arşivin tamamına göz at →</a>
				</section>
			)}
			</>
		) : (
			<div class="news-empty-state">
				<h2>Henüz yayınlanmış haber yok.</h2>
				<p>İskelet hazır. İlk haber girildiğinde bu akış canlı çalışmaya başlayacak.</p>
			</div>
		)}
	</div>
</NewsLayout>

<script is:inline type="application/json" id="news-home-config" set:html={newsHomeConfigJson}></script>

<script>
	import { gorselKaynagi, KART_SIZES, MANSET_SIZES } from '../data/gorsel';

	type ClientLeadPanelItem = {
		href: string;
		title: string;
		description: string;
		heroImage: string;
		category: string;
		categoryToken: string;
		breaking: boolean;
		pubDateIso: string;
		pubDateLabel: string;
		author: string;
	};

	type ClientStreamPanelItem = ClientLeadPanelItem & { authorRole: string };

	type ClientHomePanel = {
		leadEntry: ClientLeadPanelItem | null;
		streamEntries: ClientStreamPanelItem[];
	};

	type NewsHomeConfig = {
		panels: Record<string, ClientHomePanel>;
		categorySlugMap: Record<string, string>;
		newsHomePath: string;
		archiveHref: string;
	};

	const newsHomeConfigElement = document.getElementById('news-home-config');
	const newsHomeConfig = (newsHomeConfigElement?.textContent
		? JSON.parse(newsHomeConfigElement.textContent)
		: { panels: {}, categorySlugMap: {}, newsHomePath: '/', archiveHref: '/sayfa/1/' }) as NewsHomeConfig;
	const { panels, categorySlugMap, newsHomePath, archiveHref } = newsHomeConfig;

	function gorselEtiketi(heroImage: string, sizes: string, yukleme: 'eager' | 'lazy', sinif = '') {
		if (!heroImage) return '';
		const g = gorselKaynagi(heroImage, sizes);
		return [
			'<img',
			sinif ? ` class="${sinif}"` : '',
			` src="${escapeHtml(g.src)}"`,
			g.srcset ? ` srcset="${escapeHtml(g.srcset)}"` : '',
			g.sizes ? ` sizes="${escapeHtml(g.sizes)}"` : '',
			' width="1200" height="675" alt=""',
			` loading="${yukleme}" decoding="async">`,
		].join('');
	}

	function escapeHtml(value = '') {
		return String(value)
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#39;');
	}

	/* Aşağıdaki fonksiyonlar, sayfanın sunucuda basılan markup'ının TARAYICI
	   KOPYASI: kategoriye tıklandığında panel burada yeniden çiziliyor.
	   Sunucudaki karşılıkları `.featured-lead-card` bloğu ve
	   `NewsCard.astro`. Biri değişirse diğeri de değişmeli. */
	function renderLead(item: ClientLeadPanelItem) {
		return `
			<a href="${escapeHtml(item.href)}" class="featured-lead-card">
				${gorselEtiketi(item.heroImage, MANSET_SIZES, 'eager')}
				<div class="featured-overlay lead"></div>
				<div class="featured-lead-content">
					<div class="featured-lead-topline">
						${item.category ? `<span class="featured-badge" data-category="${escapeHtml(item.categoryToken)}">${escapeHtml(item.category)}</span>` : ''}
						${item.breaking ? '<span class="featured-badge breaking">Son Dakika</span>' : ''}
					</div>
					<h2>${escapeHtml(item.title)}</h2>
					<p>${escapeHtml(item.description)}</p>
					<div class="featured-meta-row">
						<time datetime="${escapeHtml(item.pubDateIso)}">${escapeHtml(item.pubDateLabel)}</time>
						<span>${escapeHtml(item.author)}</span>
					</div>
				</div>
			</a>
		`;
	}

	function renderStreamCard(item: ClientStreamPanelItem) {
		return `
			<article class="news-card" data-news-card data-category="${escapeHtml(item.categoryToken)}">
				<div class="news-card-copy">
					${item.breaking ? '<span class="breaking-pill">SON DAKİKA</span>' : ''}
					<div class="news-card-head">
						${item.category ? `<span class="news-category" data-category="${escapeHtml(item.categoryToken)}">${escapeHtml(item.category)}</span>` : ''}
						<time datetime="${escapeHtml(item.pubDateIso)}">${escapeHtml(item.pubDateLabel)}</time>
					</div>
					<a class="news-card-title" href="${escapeHtml(item.href)}">${escapeHtml(item.title)}</a>
					<p class="news-card-desc">${escapeHtml(item.description)}</p>
					<div class="news-card-meta">
						<span class="news-author">${escapeHtml(item.author)}</span>
						${item.authorRole ? `<span class="news-author-role">${escapeHtml(item.authorRole)}</span>` : ''}
						<a class="news-read-link" href="${escapeHtml(item.href)}">Devamını oku</a>
					</div>
				</div>
				${item.heroImage ? `<a class="news-card-image-link" href="${escapeHtml(item.href)}" aria-hidden="true" tabindex="-1">${gorselEtiketi(item.heroImage, KART_SIZES, 'lazy', 'news-card-image')}</a>` : ''}
			</article>
		`;
	}

	function renderStream(panel: ClientHomePanel) {
		if (panel.streamEntries.length === 0) return '';
		return `
			<section class="home-stream" aria-label="Son haberler">
				<div class="home-stream-head">
					<p>Akış</p>
					<h2>Son haberler</h2>
				</div>
				<div class="home-stream-list" data-home-stream-list>
					${panel.streamEntries.map(renderStreamCard).join('')}
				</div>
				<a class="home-stream-more" href="${escapeHtml(archiveHref)}">Arşivin tamamına göz at →</a>
			</section>
		`;
	}

	function renderPanel(name: string) {
		const root = document.querySelector('[data-news-home-root]');
		if (!(root instanceof HTMLElement)) return;
		const panel = panels[name] ?? panels['Tümü'];
		if (!panel || !panel.leadEntry) {
			root.innerHTML = `
				<div class="news-empty-state">
					<h2>Bu kategoride henüz yayınlanmış haber yok.</h2>
					<p>İlk kayıt geldiğinde akış burada görünecek.</p>
				</div>
			`;
			return;
		}

		root.innerHTML = `
			<section class="featured-news-grid">
				${renderLead(panel.leadEntry)}
			</section>
			${renderStream(panel)}
		`;
	}

	function syncNav(activeCategory: string) {
		document.querySelectorAll('[data-news-nav] a').forEach((link) => {
			if (!(link instanceof HTMLAnchorElement)) return;
			const label = link.textContent?.trim() || '';
			if (label === activeCategory) link.setAttribute('aria-current', 'page');
			else link.removeAttribute('aria-current');
		});
	}

	function categoryFromUrl(url: URL) {
		const slug = url.searchParams.get('kategori');
		if (!slug) return 'Tümü';
		return categorySlugMap[slug] ?? 'Tümü';
	}

	function applyCategory(category: string, updateUrl = true) {
		renderPanel(category);
		syncNav(category);
		if (updateUrl) {
			const nextUrl = new URL(window.location.href);
			if (category === 'Tümü') nextUrl.searchParams.delete('kategori');
			else {
				const slug = Object.entries(categorySlugMap).find(([, value]) => value === category)?.[0];
				if (slug) nextUrl.searchParams.set('kategori', slug);
			}
			window.history.replaceState({}, '', `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`);
		}
	}

	function initNewsCategoryFilters() {
		const homeRoot = document.querySelector('[data-news-home-root]');
		if (!(homeRoot instanceof HTMLElement)) return;
		if (document.body.dataset.newsCategoryBound === '1') return;
		document.body.dataset.newsCategoryBound = '1';

		applyCategory(categoryFromUrl(new URL(window.location.href)), false);

		document.querySelectorAll('[data-news-nav] a').forEach((link) => {
			if (!(link instanceof HTMLAnchorElement)) return;
			link.addEventListener('click', (event) => {
				const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
				if (currentPath !== newsHomePath) return;
				const url = new URL(link.href, window.location.origin);
				const targetPath = url.pathname.replace(/\/+$/, '') || '/';
				if (targetPath !== newsHomePath) return;
				event.preventDefault();
				applyCategory(categoryFromUrl(url));
			});
		});

		window.addEventListener('popstate', () => {
			if (!document.querySelector('[data-news-home-root]')) return;
			applyCategory(categoryFromUrl(new URL(window.location.href)), false);
		});
	}

	initNewsCategoryFilters();
	document.addEventListener('astro:page-load', () => {
		document.body.dataset.newsCategoryBound = '0';
		initNewsCategoryFilters();
	});
</script>

<style is:global>
	.featured-news-grid {
		display: grid;
		gap: 0.85rem;
		padding-top: 0.24rem;
	}
	.featured-lead-card {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: 1.15rem;
		border: 1px solid color-mix(in srgb, var(--news-border) 80%, rgba(255,255,255,0.08));
		background: #0b0b0b;
		text-decoration: none;
		box-shadow: var(--news-shadow);
		transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
	}
	/* Manşetin boyu EKRANA bağlı, sabit değil.
	 *
	 * Sabit 400px'ken manşet yan sütunun boyuna geriliyordu: 1440×900'de
	 * 749px'e çıkıyor ve kartın alt kenarı ekranın 7px altında bitiyordu.
	 * Okuyucu ilk bakışta sayfanın tamamını görmüş oluyordu — altta 12
	 * haber daha olduğuna dair tek bir işaret yoktu. Samet "sanki altta
	 * haber yokmuş gibi anlaşılıyor" dedi; ölçünce haklı çıktı.
	 *
	 * `48vh` bunu ekran boyundan bağımsız çözüyor: manşet ekranın yarısını
	 * alıyor, "Son haberler" başlığı ve ilk kart HER ZAMAN katlamanın
	 * üstünde kalıyor. Alt sınır kısa ekranlar, üst sınır çok uzun
	 * ekranlar için — 27 inçlik bir monitörde manşet 800px olmasın. */
	.featured-lead-card {
		min-height: clamp(320px, 48vh, 520px);
	}
	.featured-lead-card:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--news-accent) 35%, var(--news-border));
		box-shadow: 0 22px 60px rgba(0,0,0,0.26);
	}
	html[data-theme='light'] .featured-lead-card {
		box-shadow: 0 14px 32px rgba(37, 28, 18, 0.08);
	}
	html[data-theme='light'] .featured-lead-card:hover {
		box-shadow: 0 18px 40px rgba(37, 28, 18, 0.12);
	}
	.featured-lead-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: saturate(0.92) brightness(0.78);
		transform: scale(1.01);
	}
	/* Manşet görseli mutlak konumda: kartın kendisi yalnız `min-height`
	   taşıyor, yani görselin yaslanacağı kesin bir yükseklik yok. Eskiden bu
	   işi slaytların `inset: 0` sarmalayıcısı yapıyordu. */
	.featured-lead-card img {
		position: absolute;
		inset: 0;
	}
	.featured-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0,0,0,0.03) 0%, rgba(0,0,0,0.82) 100%);
	}
	.featured-overlay.lead {
		background: linear-gradient(180deg, rgba(0,0,0,0.02) 0%, rgba(0,0,0,0.2) 28%, rgba(0,0,0,0.88) 100%);
	}
	.featured-lead-content {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 2;
		padding: 0.9rem;
	}
	/* Alttaki 3.4rem, numaralı slayt sayacına ayrılmış yerdi. Sayaç gitti. */
	.featured-lead-content {
		padding: 1rem 0.9rem 1.15rem 1.05rem;
	}
	.featured-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.22rem 0.48rem;
		border-radius: 999px;
		background: rgba(255,255,255,0.12);
		border: 1px solid rgba(255,255,255,0.1);
		backdrop-filter: blur(8px);
		color: #fff;
		font-size: 0.64rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.featured-badge.breaking {
		background: rgba(185, 28, 28, 0.95);
	}
	.featured-badge[data-category='siyaset'] {
		background: rgba(249, 115, 96, 0.16);
		border-color: rgba(249, 115, 96, 0.28);
		color: #fff2ef;
	}
	.featured-badge[data-category='ekonomi'] {
		background: rgba(242, 185, 75, 0.18);
		border-color: rgba(242, 185, 75, 0.28);
		color: #fff8ea;
	}
	.featured-badge[data-category='bilim'] {
		background: rgba(96, 165, 250, 0.18);
		border-color: rgba(96, 165, 250, 0.28);
		color: #eef6ff;
	}
	.featured-badge[data-category='teknoloji'] {
		background: rgba(52, 211, 153, 0.18);
		border-color: rgba(52, 211, 153, 0.28);
		color: #ecfff8;
	}
	/* Manşet rozeti zeminini temadan DEĞİL fotoğraftan alır: her iki temada
	 * da koyu bir görselin üstünde durur, o yüzden rengi tema değişince
	 * değişmiyor. Bir dönem aydınlık tema için koyu bir varyantı vardı ve
	 * fotoğrafın üstünde okunmuyordu. */
	/* Serif manşet; tek ağırlık olduğu için 700 (bkz. `BaseLayout`taki
	   `--news-serif` notu). */
	.featured-lead-content h2 {
		font-family: var(--news-serif);
		font-weight: 700;
		margin: 0.45rem 0 0;
		color: #fff;
		text-wrap: balance;
	}
	.featured-lead-content h2 {
		font-size: clamp(1.55rem, 2.6vw, 2.15rem);
		line-height: 1.12;
		letter-spacing: -0.02em;
		max-width: 22ch;
		text-wrap: balance;
	}
	.featured-lead-topline {
		display: flex;
		gap: 0.45rem;
		flex-wrap: wrap;
	}
	.featured-lead-content p {
		margin-top: 0.5rem;
		max-width: 50ch;
		color: rgba(255,255,255,0.82);
		font-size: 0.9rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-box-orient: vertical;
