              "siber-guvenlik",
              "dijital-dunya",
              "teknoloji-sektoru"
            ]
          },
          "kaynaklar": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "slug": {
            "type": "string"
          }
        }
