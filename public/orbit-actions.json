      "idempotent": true,
      "input": {
        "type": "object",
        "required": [
          "slug",
          "gerekce"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 200
          },
          "gerekce": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "output": {
        "type": "object",
