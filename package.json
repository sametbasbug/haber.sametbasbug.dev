{
  "name": "haber-sametbasbug-dev",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Editorial-first AI-assisted news publishing system for haber.sametbasbug.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sametbasbug/haber.sametbasbug.dev.git"
  },
  "homepage": "https://haber.sametbasbug.dev",
  "bugs": {
    "url": "https://github.com/sametbasbug/haber.sametbasbug.dev/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:ssr": "npm run build:ssr && npm run dev:db && wrangler dev --config wrangler.ssr.jsonc",
    "dev:db": "wrangler d1 migrations apply haber --local --config wrangler.ssr.jsonc",
    "build": "npm run gorsel:kucuk && astro build",
    "build:ssr": "npm run gorsel:kucuk && astro build --config astro.config.ssr.mjs",
    "deploy": "wrangler deploy --config wrangler.ssr.jsonc",
    "typecheck": "astro sync && npm run types:gen && tsc --noEmit -p tsconfig.json",
    "types:gen": "wrangler types --config wrangler.ssr.jsonc",
    "preview": "astro preview",
    "astro": "astro",
    "ozet:new": "node scripts/new-gunluk-ozet.mjs",
    "news:prepare": "newsroom/.venv/bin/newsroom prepare",
    "news:publish": "newsroom/.venv/bin/newsroom publish --stdin",
    "news:status": "newsroom/.venv/bin/newsroom status",
    "haber:ayna": "node scripts/haber-ayna.mjs",
    "haber:ayna:kuru": "node scripts/haber-ayna.mjs --kuru",
    "test:newsroom": "newsroom/.venv/bin/python -m pytest newsroom/tests",
    "test:orbit": "node worker/tools/orbit-token-tests.mjs && node worker/tools/orbit-giris-tests.mjs && node worker/tools/identity-tests.mjs && node worker/tools/orbit-eylem-tests.mjs",
    "quality": "npm run test:newsroom && npm run test:orbit && npm run test:technology && npm run test:newsroom-catalog && npm run test:smoke-url && npm run test:technology-pagination && npm run test:technology-theme && npm run test:release-d1-check && npm run test:technology-preflight && npm run test:d1-recovery && npm run test:d1-export-integrity && npm run test:backup-attestation && npm run test:staging-config && npm run test:technology-deploy-order && npm run test:legacy-permalinks && npm run test:orbit-release-check && npm run typecheck && npm run build",
    "gorsel:kucuk": "node scripts/kucuk-gorsel.mjs",
    "test:technology": "node worker/tools/technology-contract-tests.mjs && node worker/tools/technology-migration-tests.mjs && node worker/tools/technology-publication-tests.mjs && node worker/tools/technology-local-recovery-tests.mjs",
    "test:smoke-url": "node scripts/first-article-url-tests.mjs",
    "test:newsroom-catalog": "node scripts/newsroom-action-catalog-tests.mjs",
    "smoke:newsroom-catalog": "node scripts/newsroom-action-catalog.mjs",
    "test:technology-pagination": "node scripts/technology-pagination-tests.mjs",
    "test:release-d1-check": "node scripts/technology-release-d1-check-tests.mjs",
    "test:orbit-release-check": "node scripts/orbit-technology-release-check-tests.mjs",
    "smoke:orbit-release-check": "node scripts/orbit-technology-release-check.mjs",
    "test:d1-recovery": "node scripts/d1-time-travel-check-tests.mjs",
    "test:d1-export-integrity": "node scripts/d1-export-integrity-tests.mjs",
    "test:backup-attestation": "node scripts/technology-backup-attestation-tests.mjs",
    "test:staging-config": "node scripts/technology-staging-config-tests.mjs",
    "test:technology-deploy-order": "node scripts/technology-deploy-order-tests.mjs",
    "test:technology-preflight": "node scripts/technology-pre-migration-check-tests.mjs",
    "test:legacy-permalinks": "node scripts/technology-legacy-permalinks-tests.mjs",
    "test:technology-theme": "node scripts/technology-theme-tests.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "astro": "^7.4.12",
    "rehype-sanitize": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.8",
    "jsonc-parser": "3.3.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "4.162.0"
  },
  "overrides": {
    "volar-service-yaml": "^0.0.71",
    "yaml-language-server": "^1.24.0",
    "yaml": "^2.9.1",
    "esbuild": "^0.28.2"
  }
}
