{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "dist-ssr"
  ],
  "compilerOptions": {
    // `baseUrl` YOK ve olmamalı: TypeScript 5'ten beri `paths` ona bağlı
    // değil, değerler tsconfig'in bulunduğu dizine göre çözülüyor. TS 6'da
    // `baseUrl` doğrudan hata veriyordu ve `tsc --noEmit` hiç koşmuyordu —
    // yani tür kontrolünün tamamı kapalıydı. Aynı satır TS 7 geçişinin de
    // engeliydi.
    "paths": {
      "#runtime-env": [
        "./src/data/runtimeEnv.ts"
      ],
      "#news-source": [
        "./src/data/newsSource.ts"
      ]
    }
  }
}
